\par }\pard \widctlpar\adjustright {\b\i\fs24 N\'aci nh\'cbn :}{\fs24 
\par }{\fs22 - Ban B\'dd th\'ad Trung \'ad\'acng \'a7\'b6ng,
\par - Th\'f1 t\'ad\'edng, c\'b8c Ph\'e3 Th\'f1 t\'ad\'edng Ch\'ddnh ph\'f1,
\par - C\'b8c B\'e9, c\'ac quan ngang B\'e9,
\par   c\'ac quan thu\'e9c Ch\'ddnh ph\'f1,
\par - H\'a7ND, UBND c\'b8c t\'d8nh, th\'b5nh ph\'e8
\par   tr\'f9c thu\'e9c Trung \'ad\'acng,
\par - V\'a8n ph\'dfng Trung \'ad\'acng v\'b5 c\'b8c Ban c\'f1a \'a7\'b6ng,
\par - V\'a8n ph\'dfng Qu\'e8c h\'e9i,
\par - H\'e9i \'ae\'e5ng D\'a9n t\'e9c v\'b5 c\'b8c UB c\'f1a Qu\'e8c h\'e9i,  
\par - V\'a8n ph\'dfng Ch\'f1 t\'dech n\'ad\'edc,
\par - T\'dfa \'b8n nh\'a9n d\'a9n t\'e8i cao,}{\b                                                          }{\fs22 
\par - Vi\'d6n Ki\'d3m s\'b8t nh\'a9n d\'a9n t\'e8i cao,
\par - C\'ac quan Trung \'ad\'acng c\'f1a c\'b8c \'aeo\'b5n th\'d3,}{\b                              Nguy\'d4n T\'can D\'f2ng \'ae\'b7 k\'fd}{\fs22 
\par - H\'e4c vi\'d6n H\'b5nh ch\'ddnh qu\'e8c gia,
