\par }\pard \qj\fi547\ri-86\sb240\sl276\slmult1\widctlpar\adjustright {\b\cf1 \'a7i\'d2u 1}{\b\i\cf1 . }{\cf1 Ngh\'de \'ae\'denh n\'b5y quy \'ae\'denh chi ti\'d5t thi h\'b5nh m\'e9t s\'e8 \'aei\'d2u c\'f1a Ph\'b8p l\'d6nh C\'ac y\'d5u v\'d2 ch\'d5 \'ae\'e9, ch
\'ddnh s\'b8ch \'ae\'e8i v\'edi ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u \'aeang h\'ad\'ebng b\'b6ng l\'ad\'acng l\'f9c l\'ad\'eeng v\'f2 trang m\'b5 kh\'abng ph\'b6i l\'b5 qu\'a9n nh\'a9n ho\'c6c C\'abng an nh\'a9n d\'a9n khi ngh\'d8 h\'adu, chuy
\'d3n ng\'b5nh, th\'abi vi\'d6c ho\'c6c chuy\'d3n sang l\'b5m c\'abng t\'b8c kh\'b8c trong t\'e6 ch\'f8c c\'ac y\'d5u.
\par }{\b\cf1 \'a7i\'d2u 2. }{\cf1 Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u khi ngh\'d8 h\'adu, chuy\'d3n ng\'b5nh, th\'abi vi\'d6c ho\'c6c chuy\'d3n sang l\'b5m c\'abng t\'b8c kh\'b8c trong t\'e6 ch\'f8c c\'ac y\'d5u \'ae\'ad\'eec h\'ad\'ebng ch\'d5 
\'ae\'e9, ch\'ddnh s\'b8ch theo quy \'ae\'denh c\'f1a Ph\'b8p l\'d6nh C\'ac y\'d5u, quy \'ae\'denh chi ti\'d5t t\'b9i Ngh\'de \'ae\'denh n\'b5y v\'b5 c\'b8c quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt hi\'d6n h\'b5nh kh\'b8c c\'e3 li\'aan quan.
\par }{\b\cf1 \'a7i\'d2u 3.}{\cf1  Ng\'a9n s\'b8ch nh\'b5 n\'ad\'edc b\'b6o \'ae\'b6m ngu\'e5n kinh ph\'dd th\'f9c hi\'d6n m\'e9t s\'e8 ch\'d5 \'ae\'e9, ch\'ddnh s\'b8ch quy \'ae\'denh t\'b9i Ngh\'de \'ae\'denh n\'b5y \'ae\'e8i v\'edi ng\'ad\'eai l\'b5m vi\'d6
c trong t\'e6 ch\'f8c c\'ac y\'d5u v\'b5 c\'cap kinh ph\'dd \'ae\'e3ng b\'b6o hi\'d3m x\'b7 h\'e9i b\'e6 sung cho th\'eai gian \'ae\'b5o t\'b9o t\'b9i c\'b8c tr\'ad\'eang c\'ac y\'d5u c\'f1a ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u.
\par }\pard \qj\fi540\ri-81\sa120\widctlpar\adjustright {\cf1 
\par }\pard \qc\ri-86\widctlpar\adjustright {\b\cf1 Ch\'ad\'acng II}{\b\i\cf1 
\par }{\b\f17\fs26\cf1 Ch\'d5 \'ae\'e9, ch\'ddnh s\'b8ch \'ae\'e8i v\'edi ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u 
\par th\'abi l\'b5m vi\'d6c trong t\'e6 ch\'f8c c\'ac y\'d5u
\par 
\par }{\b\cf1 M\'f4c I}{\b\i\cf1 
\par }{\b\f17\fs26\cf1 Ch\'d5 \'ae\'e9, ch\'ddnh s\'b8ch \'ae\'e8i v\'edi ng\'ad\'eai l\'b5m c\'abng t\'b8c
\par  c\'ac y\'d5u ngh\'d8 h\'adu
\par }\pard \qj\fi547\ri-86\widctlpar\adjustright {\b\cf1 
\par \'a7i\'d2u 4.}{
\par }\pard \qj\fi547\ri-86\sl276\slmult1\widctlpar\adjustright {\cf1 1. Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u ngh\'d8 vi\'d6c \'ae\'ad\'eec h\'ad\'ebng ch\'d5 \'ae\'e9 h\'adu tr\'dd h\'b5ng th\'b8ng khi c\'e3 \'ae\'f1 \'aei\'d2u ki\'d6n quy \'ae\'de
nh t\'b9i kho\'b6n 1 ho\'c6c kho\'b6n 2 \'a7i\'d2u 23 ho\'c6c      \'a7i\'d2u 24 c\'f1a \'a7i\'d2u l\'d6 b\'b6o hi\'d3m x\'b7 h\'e9i \'ae\'e8i v\'edi s\'dc quan, qu\'a9n nh\'a9n chuy\'aan nghi\'d6p, binh s\'dc Qu\'a9n \'ae\'e9i nh\'a9n d\'a9n v\'b5 C\'ab
ng an nh\'a9n d\'a9n ban h\'b5nh k\'ccm theo Ngh\'de \'ae\'denh s\'e8 45/CP ng\'b5y 15 th\'b8ng 7 n\'a8m 1995 c\'f1a Ch\'ddnh ph\'f1; \'a7i\'d2u 27 c\'f1a Ngh\'de \'ae\'denh s\'e8 45/CP \'ae\'b7 \'ae\'ad\'eec s\'f6a \'ae\'e6i, b\'e6 sung t\'b9i Ngh\'de 
\'ae\'denh s\'e8 89/2003/N\'a7-CP ng\'b5y 05 th\'b8ng 8 n\'a8m 2003 v\'d2 vi\'d6c s\'f6a \'ae\'e6i, b\'e6 sung m\'e9t s\'e8 \'aei\'d2u c\'f1a \'a7i\'d2u l\'d6 b\'b6o hi\'d3m x\'b7 h\'e9i \'ae\'e8i v\'edi s\'dc quan, qu\'a9n nh\'a9n chuy\'aan nghi\'d6p, h
\'b9 s\'dc quan, binh s\'dc Qu\'a9n \'ae\'e9i nh\'a9n d\'a9n v\'b5 C\'abng an nh\'a9n d\'a9n ban h\'b5nh k\'ccm theo Ngh\'de \'ae\'denh                   s\'e8 45/CP ng\'b5y 15 th\'b8ng 7 n\'a8m 1995 c\'f1a Ch\'ddnh ph\'f1.
\par 
\par  2. Trong tr\'ad\'eang h\'eep ch\'ada \'ae\'f1 \'aei\'d2u ki\'d6n ngh\'d8 h\'adu theo quy \'ae\'denh t\'b9i            kho\'b6n 1 \'a7i\'d2u n\'b5y, m\'b5 t\'e6 ch\'f8c c\'ac y\'d5u kh\'abng c\'dfn nhu c\'c7u b\'e8 tr\'dd l\'b5m vi\'d6c trong t\'e6 ch\'f8
c c\'ac y\'d5u ho\'c6c kh\'abng chuy\'d3n ng\'b5nh \'ae\'ad\'eec, th\'d7 ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u ngh\'d8 vi\'d6c \'ae\'ad\'eec h\'ad\'ebng ch\'d5 \'ae\'e9 h\'adu tr\'dd h\'b5ng th\'b8ng khi c\'e3 \'ae\'f1 c\'b8c \'aei\'d2u ki\'d6
n sau \'ae\'a9y :
\par 
\par C\'e3 \'ae\'f1 25 n\'a8m \'ae\'e8i v\'edi nam v\'b5 c\'e3 \'ae\'f1 20 n\'a8m \'ae\'e8i v\'edi n\'f7 l\'b5m vi\'d6c trong t\'e6 ch\'f8c c\'ac y\'d5u tr\'eb l\'aan v\'b5 ph\'b6i \'ae\'e3ng \'ae\'f1 b\'b6o hi\'d3m x\'b7 h\'e9i .
\par 
\par Th\'eai gian l\'b5m vi\'d6c trong t\'e6 ch\'f8c c\'ac y\'d5u bao g\'e5m : th\'eai gian l\'b5m c\'abng t\'b8c c\'ac y\'d5u v\'b5 th\'eai gian l\'b5m c\'abng vi\'d6c kh\'b8c trong t\'e6 ch\'f8c c\'ac y\'d5u, trong \'ae\'e3 ph\'b6i c\'e3 \'ddt nh\'cat 05 n
\'a8m \'ae\'ad\'eec t\'ddnh th\'a9m ni\'aan  ng\'b5nh c\'ac y\'d5u. Th\'eai gian l\'b5m vi\'d6c trong t\'e6 ch\'f8c c\'ac y\'d5u \'ae\'ad\'eec t\'ddnh theo n\'a8m (kh\'abng quy \'ae\'e6i theo h\'d6 s\'e8), n\'d5u c\'e3 th\'eai gian \'ae\'f8t qu\'b7ng th
\'d7 \'ae\'ad\'eec c\'e9ng d\'e5n.
\par 
\par }\pard \qj\fi547\ri-86\widctlpar\adjustright {\b\cf1 \'a7i\'d2u 5.}{\cf1  C\'b8ch t\'ddnh l\'ad\'acng h\'adu h\'b5ng th\'b8ng c\'f1a ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u \'ae\'ad\'eec th\'f9c hi\'d6n theo quy \'ae\'denh t\'b9i \'a7i\'d2u 25 \'a7
i\'d2u l\'d6 b\'b6o hi\'d3m x\'b7 h\'e9i ban h\'b5nh k\'ccm theo Ngh\'de \'ae\'denh s\'e8 45/CP ng\'b5y 15 th\'b8ng 7 n\'a8m 1995 v\'b5 \'a7i\'d2u 25, \'a7i\'d2u 26 c\'f1a Ngh\'de \'ae\'denh s\'e8 45/CP \'ae\'b7 \'ae\'ad\'eec s\'f6a \'ae\'e6i, b\'e6
 sung t\'b9i Ngh\'de \'ae\'denh                               s\'e8 89/2003/N\'a7-CP ng\'b5y 05 th\'b8ng 8 n\'a8m 2003 v\'d2 vi\'d6c s\'f6a \'ae\'e6i, b\'e6 sung m\'e9t              s\'e8 \'aei\'d2u c\'f1a \'a7i\'d2u l\'d6 b\'b6o hi\'d3m x\'b7 h\'e9i \'ae
\'e8i v\'edi s\'dc quan, qu\'a9n nh\'a9n chuy\'aan nghi\'d6p, h\'b9 s\'dc quan, binh s\'dc Qu\'a9n \'ae\'e9i nh\'a9n d\'a9n v\'b5 C\'abng an nh\'a9n d\'a9n ban h\'b5nh k\'ccm theo Ngh\'de \'ae\'denh s\'e8 45/CP ng\'b5y 15 th\'b8ng 7 n\'a8m 1995 c\'f1a Ch
\'ddnh ph\'f1.
\par }\pard \qc\ri-81\sa120\widctlpar\adjustright {\b\cf1 
\par M\'f4c II }{\b 
\par }{\b\f17\fs26\cf1 ch\'d5 \'ae\'e9, ch\'ddnh s\'b8ch \'ae\'e8i v\'edi ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u chuy\'d3n ng\'b5nh}{\b\cf1 
\par }\pard \qj\fi547\ri-86\sb240\sl269\slmult1\widctlpar\adjustright {\b\cf1 \'a7i\'d2u 6. }{\cf1 Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u chuy\'d3n ng\'b5nh sang l\'b5m vi\'d6c trong bi\'aan ch\'d5 t\'b9i c\'b8c c\'ac quan nh\'b5 n\'ad\'edc, t\'e6 ch
\'f8c ch\'ddnh tr\'de, t\'e6 ch\'f8c ch\'ddnh tr\'de - x\'b7 h\'e9i h\'ad\'ebng l\'ad\'acng t\'f5 ng\'a9n s\'b8ch nh\'b5 n\'ad\'edc, \'ae\'ad\'eec h\'ad\'ebng c\'b8c quy\'d2n l\'eei nh\'ad sau :
\par 1. \'a7\'ad\'eec \'adu ti\'aan b\'e8 tr\'dd vi\'d6c l\'b5m ph\'ef h\'eep v\'edi ng\'b5nh, ngh\'d2 chuy\'aan m\'abn, k\'fc thu\'cbt, nghi\'d6p v\'f4; \'ae\'ad\'eec \'ae\'b5o t\'b9o b\'e5i d\'ad\'ecng v\'d2 chuy\'aan m\'abn, nghi\'d6p v\'f4 c\'c7n thi\'d5
t ph\'ef h\'eep v\'edi c\'abng vi\'d6c \'ae\'b6m nhi\'d6m.
\par 2. \'a7\'ad\'eec mi\'d4n thi tuy\'d3n v\'b5 \'ae\'ad\'eec s\'bep x\'d5p l\'b5m vi\'d6c theo \'ae\'f3ng chuy\'aan m\'abn nghi\'d6p v\'f4, n\'d5u chuy\'d3n ng\'b5nh theo y\'aau c\'c7u c\'f1a c\'ac quan nh\'b5 n\'ad\'edc c\'e3 th\'c8m quy\'d2n.
\par 3. \'a7\'ad\'eec x\'d5p v\'b5 h\'ad\'ebng l\'ad\'acng theo c\'abng vi\'d6c, ch\'f8c v\'f4 m\'edi k\'d3 t\'f5 ng\'b5y c\'e3 quy\'d5t \'ae\'denh chuy\'d3n ng\'b5nh. Tr\'ad\'eang h\'eep h\'d6 s\'e8 m\'f8c l\'ad\'acng m\'edi th\'cap h\'acn h\'d6 s\'e8 m\'f8
c l\'ad\'acng c\'f1a ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u \'ae\'ad\'eec h\'ad\'ebng t\'b9i th\'eai \'aei\'d3m chuy\'d3n ng\'b5nh th\'d7 \'ae\'ad\'eec b\'b6o l\'adu h\'d6 s\'e8 ch\'aanh l\'d6ch gi\'f7a h\'d6 s\'e8 m\'f8c l\'ad\'acng c\'f1a ng\'ad
\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u v\'edi h\'d6 s\'e8 m\'f8c l\'ad\'acng m\'edi trong th\'eai gian l\'b5 18 th\'b8ng k\'d3 t\'f5 ng\'b5y c\'e3 quy\'d5t \'ae\'denh chuy\'d3n ng\'b5nh v\'b5 do c\'ac quan, \'ae\'acn v\'de m\'edi chi tr\'b6. Trong th
\'eai gian \'ae\'ad\'eec b\'b6o l\'adu, n\'d5u h\'d6 s\'e8 m\'f8c l\'ad\'acng m\'edi \'ae\'ad\'eec n\'a9ng b\'bbng ho\'c6c cao h\'acn h\'d6 s\'e8 m\'f8c l\'ad\'acng c\'f1a ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u tr\'ad\'edc khi chuy\'d3n ng\'b5
nh th\'d7 h\'ad\'ebng theo h\'d6 s\'e8 m\'f8c l\'ad\'acng m\'edi.
\par 4. Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u \'ae\'b7 chuy\'d3n ng\'b5nh khi ngh\'d8 h\'adu, c\'b8ch t\'ddnh l\'ad\'acng h\'adu c\'f4 th\'d3 nh\'ad sau :
\par a) \'a7\'ad\'eec l\'cay m\'f8c l\'ad\'acng l\'b5m c\'a8n c\'f8 t\'ddnh l\'ad\'acng h\'adu t\'b9i th\'eai \'aei\'d3m ngh\'d8 h\'adu c\'e9ng th\'aam kho\'b6n ph\'f4 c\'cap th\'a9m ni\'aan t\'ddnh theo th\'eai gian l\'b5m vi\'d6c trong c\'b8c t\'e6 ch\'f8c c
\'ac y\'d5u c\'f1a m\'f8c l\'ad\'acng t\'b9i th\'eai \'aei\'d3m chuy\'d3n ng\'b5nh \'ae\'d3 l\'b5m c\'ac s\'eb t\'ddnh l\'ad\'acng h\'adu.
\par b) Tr\'ad\'eang h\'eep ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u \'ae\'b7 chuy\'d3n ng\'b5nh, khi ngh\'d8 h\'adu m\'b5 c\'e3 m\'f8c l\'ad\'acng h\'adu t\'ddnh theo quy \'ae\'denh t\'b9i \'aei\'d3m a kho\'b6n 4 \'a7i\'d2u n\'b5y th\'cap h\'acn m\'f8
c l\'ad\'acng h\'adu t\'ddnh theo m\'f8c l\'ad\'acng \'eb th\'eai \'aei\'d3m tr\'ad\'edc khi chuy\'d3n ra kh\'e1i ng\'b5nh c\'ac y\'d5u th\'d7 \'ae\'ad\'eec l\'cay m\'f8c l\'ad\'acng \'eb th\'eai \'aei\'d3m tr\'ad\'edc khi chuy\'d3n ra kh\'e1i ng\'b5nh c
\'ac y\'d5u \'ae\'d3 t\'ddnh l\'ad\'acng h\'adu.
\par }\pard \qj\fi547\ri-86\sb240\sl276\slmult1\widctlpar\adjustright {\b\cf1 \'a7i\'d2u 7. }{\cf1 Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u chuy\'d3n sang l\'b5m vi\'d6c t\'b9i c\'b8c t\'e6 ch\'f8c kh\'b8c kh\'abng h\'ad\'ebng l\'ad\'acng t\'f5 ng\'a9n s
\'b8ch nh\'b5 n\'ad\'edc th\'d7 \'ae\'ad\'eec h\'ad\'ebng tr\'ee c\'cap th\'abi vi\'d6c theo quy \'ae\'denh t\'b9i kho\'b6n 2 \'a7i\'d2u 8 Ngh\'de \'ae\'denh n\'b5y v\'b5 \'ae\'ad\'eec b\'b6o l\'adu ph\'c7n b\'b6o hi\'d3m x\'b7 h\'e9i c\'f1a th\'ea
i gian l\'b5m c\'abng t\'b8c c\'ac y\'d5u.
\par }\pard \qc\ri-81\sa120\widctlpar\adjustright {\b\cf1 
\par M\'f4c III
\par }\pard \qc\ri-86\widctlpar\adjustright {\b\f17\fs26\cf1 ch\'d5 \'ae\'e9, ch\'ddnh s\'b8ch \'ae\'e8i v\'edi ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u 
\par th\'abi vi\'d6c}{\b\i\f17\fs26\cf1 
\par }\pard \qj\fi547\ri-86\sb200\sl269\slmult1\widctlpar\adjustright {\b\cf1 \'a7i\'d2u 8. }{\cf1 Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u khi th\'abi l\'b5m vi\'d6c, nh\'adng kh\'abng \'ae\'f1 \'aei\'d2u ki\'d6n \'ae\'d3 ngh\'d8 h\'adu ho\'c6c kh\'ab
ng chuy\'d3n ng\'b5nh th\'d7 gi\'b6i quy\'d5t th\'abi vi\'d6c v\'d2 \'ae\'dea ph\'ad\'acng v\'b5 \'ae\'ad\'eec h\'ad\'ebng c\'b8c quy\'d2n l\'eei nh\'ad sau :
\par 1. \'a7\'ad\'eec tr\'ee c\'cap t\'b9o vi\'d6c l\'b5m b\'bbng 06 th\'b8ng l\'ad\'acng t\'e8i thi\'d3u do Nh\'b5 n\'ad\'edc quy \'ae\'denh; \'ae\'ad\'eec \'adu ti\'aan v\'b5o h\'e4c ngh\'d2 ho\'c6c gi\'edi thi\'d6u vi\'d6c l\'b5m t\'b9i c\'b8c trung t\'a9
m d\'dech v\'f4 vi\'d6c l\'b5m c\'f1a c\'b8c B\'e9, ng\'b5nh, \'aeo\'b5n th\'d3, \'ae\'dea ph\'ad\'acng v\'b5 t\'e6 ch\'f8c kinh t\'d5 - x\'b7 h\'e9i kh\'b8c.
\par 2. \'a7\'ad\'eec tr\'ee c\'cap th\'abi vi\'d6c m\'e9t l\'c7n : c\'f8 m\'e7i n\'a8m c\'abng t\'b8c \'ae\'ad\'eec t\'ddnh b\'bbng 01 th\'b8ng l\'ad\'acng hi\'d6n h\'ad\'ebng v\'b5 ph\'f4 c\'cap (n\'d5u c\'e3). Tr\'ad\'eang h\'eep c\'e3 th\'eai gian l\'ce t
\'f5 \'ae\'f1 01 th\'b8ng \'ae\'d5n 06 th\'b8ng th\'d7 \'ae\'ad\'eec t\'ddnh l\'b5 n\'f6a (1/2) n\'a8m; t\'f5 tr\'aan 06 th\'b8ng tr\'eb l\'aan \'ae\'ad\'eec t\'ddnh tr\'dfn l\'b5 01 n\'a8m.
\par Th\'eai gian \'ae\'d3 t\'ddnh h\'ad\'ebng ch\'d5 \'ae\'e9 tr\'ee c\'cap th\'abi vi\'d6c m\'e9t l\'c7n l\'b5 t\'e6ng th\'eai gian ph\'f4c v\'f4 trong c\'b8c t\'e6 ch\'f8c c\'ac y\'d5u (bao g\'e5m th\'eai gian l\'b5m c\'abng t\'b8c c\'ac y\'d5u v\'b5 th\'ea
i gian l\'b5m c\'abng vi\'d6c kh\'b8c trong t\'e6 ch\'f8c c\'ac y\'d5u); th\'eai gian c\'abng t\'b8c trong c\'b8c c\'ac quan \'a7\'b6ng, Nh\'b5 n\'ad\'edc, t\'e6 ch\'f8c x\'b7 h\'e9i, \'aeo\'b5n th\'d3 \'eb Trung \'ad\'acng, \'ae\'dea ph\'ad\'acng v\'b5
 th\'eai gian l\'b5m h\'eep \'ae\'e5ng c\'e3 \'ae\'e3ng b\'b6o hi\'d3m x\'b7 h\'e9i (n\'d5u c\'e3).
\par 3. \'a7\'ad\'eec h\'ad\'ebng ch\'d5 \'ae\'e9 b\'b6o hi\'d3m x\'b7 h\'e9i v\'b5 c\'b8c ch\'d5 \'ae\'e9 kh\'b8c theo quy \'ae\'denh hi\'d6n h\'b5nh c\'f1a ph\'b8p lu\'cbt.
\par 4. Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u \'ae\'b7 th\'abi vi\'d6c v\'d2 \'ae\'dea ph\'ad\'acng trong th\'eai gian kh\'abng qu\'b8 01 n\'a8m, k\'d3 t\'f5 ng\'b5y k\'fd quy\'d5t \'ae\'denh th\'abi vi\'d6c, n\'d5u t\'d7m \'ae\'ad\'eec vi\'d6c l\'b5
m m\'edi, c\'e3 y\'aau c\'c7u chuy\'d3n ng\'b5nh th\'d7 \'ae\'ad\'eec th\'f9c hi\'d6n ch\'d5 \'ae\'e9 chuy\'d3n ng\'b5nh. Khi th\'f9c hi\'d6n ch\'d5 \'ae\'e9 chuy\'d3n ng\'b5nh th\'d7 ph\'b6i ho\'b5n l\'b9i kho\'b6n tr\'ee c\'cap theo quy \'ae\'denh t\'b9
i kho\'b6n 2 v\'b5 kho\'b6n 3 \'a7i\'d2u n\'b5y.
\par }\pard \qc\widctlpar\adjustright {\b 
\par M\'f4c IV
\par }{\b\f17\fs26 quy \'ae\'e6i th\'eai gian \'ae\'d3 t\'ddnh h\'ad\'ebng ch\'d5 \'ae\'e9
\par khi th\'abi l\'b5m vi\'d6c trong t\'e6 ch\'f8c c\'ac y\'d5u 
\par c\'f1a ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u
\par }{
\par }\pard \qj\fi547\widctlpar\adjustright {\b \'a7i\'d2u 9. }{Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u c\'e3 th\'eai gian chi\'d5n \'ae\'cau, tr\'f9c ti\'d5p ph\'f4c v\'f4 chi\'d5n \'ae\'cau ho\'c6c c\'abng t\'b8c \'eb \'ae\'dea b\'b5n, ng\'b5nh, ngh
\'d2 c\'e3 t\'ddnh ch\'cat \'ae\'c6c th\'ef th\'d7 \'ae\'ad\'eec quy \'ae\'e6i th\'eai gian \'ae\'e3 \'ae\'d3 t\'ddnh h\'ad\'ebng ch\'d5 \'ae\'e9 tr\'ee c\'cap m\'e9t l\'c7n khi th\'abi ph\'f4c v\'f4 trong c\'b8c t\'e6 ch\'f8c c\'ac y\'d5u nh\'ad sau :

\par 
\par 1. Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u c\'e3 th\'eai gian chi\'d5n \'ae\'cau, tr\'f9c ti\'d5p ph\'f4c v\'f4 chi\'d5n \'ae\'cau th\'d7 th\'eai gian \'ae\'e3 \'ae\'ad\'eec quy \'ae\'e6i m\'e9t n\'a8m b\'bbng m\'e9t n\'a8m s\'b8u th\'b8ng.
\par 
\par 2. Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u c\'e3 th\'eai gian c\'abng t\'b8c \'eb \'ae\'dea b\'b5n c\'e3 ph\'f4 c\'cap \'ae\'c6c bi\'d6t v\'edi m\'f8c 100% ho\'c6c ng\'b5nh ngh\'d2 \'ae\'c6c th\'ef \'ae\'ad\'eec x\'d5p lao \'ae\'e9ng \'ae\'c6c bi
\'d6t n\'c6ng nh\'e4c, \'ae\'e9c h\'b9i, nguy hi\'d3m th\'d7 th\'eai gian \'ae\'e3 \'ae\'ad\'eec quy \'ae\'e6i m\'e9t n\'a8m b\'bbng m\'e9t n\'a8m b\'e8n th\'b8ng.
\par 
\par 3. Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u c\'e3 th\'eai gian c\'abng t\'b8c \'eb \'ae\'dea b\'b5n c\'e3 ph\'f4 c\'cap khu v\'f9c t\'f5 h\'d6 s\'e8 0,7 tr\'eb l\'aan ho\'c6c ng\'b5nh ngh\'d2 \'ae\'c6c th\'ef \'ae\'ad\'eec x\'d5p lao \'ae\'e9ng n
\'c6ng nh\'e4c, \'ae\'e9c h\'b9i, nguy hi\'d3m th\'d7 th\'eai gian \'ae\'e3 \'ae\'ad\'eec quy \'ae\'e6i m\'e9t n\'a8m b\'bbng m\'e9t n\'a8m hai th\'b8ng.
\par 
\par }{\expnd0\expndtw-4 Tr\'ad\'eang h\'eep trong c\'efng m\'e9t th\'eai gian c\'abng t\'b8c, ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u c\'e3 \'ae\'f1 2 ho\'c6c 3 \'aei\'d2u ki\'d6n n\'aau tr\'aan th\'d7 \'ae\'ad\'eec h\'ad\'ebng theo m\'f8c quy \'ae\'e6
i cao nh\'cat. Th\'eai gian c\'abng t\'b8c n\'aau tr\'aan n\'d5u \'ae\'f8t qu\'b7ng th\'d7 \'ae\'ad\'eec c\'e9ng d\'e5n \'ae\'d3 x\'b8c \'ae\'denh.
\par }{
\par }{\b\expnd0\expndtw-4 \'a7i\'d2u 10. }{\expnd0\expndtw-4 Th\'eai gian t\'a8ng th\'aam do quy \'ae\'e6i quy \'ae\'denh t\'b9i \'a7i\'d2u 9 Ngh\'de \'ae\'denh n\'b5y \'ae\'ad\'eec t\'ddnh h\'ad\'ebng tr\'ee c\'cap m\'e9t l\'c7n \'ae\'e8i v\'edi ng\'ad\'ea
i l\'b5m c\'abng t\'b8c c\'ac y\'d5u th\'abi l\'b5m vi\'d6c trong t\'e6 ch\'f8c c\'ac y\'d5u (ngh\'d8 h\'adu, chuy\'d3n ng\'b5nh, th\'abi vi\'d6c) v\'edi m\'f8c c\'f8 m\'e9t n\'a8m t\'a8ng th\'aam \'ae\'ad\'eec t\'ddnh b\'bbng m\'e9t th\'b8ng l\'ad\'ac
ng v\'b5 ph\'f4 c\'cap (n\'d5u c\'e3) hi\'d6n h\'ad\'ebng.
\par }\pard \qj\fi540\widctlpar\adjustright {
\par }\pard \qj\widctlpar\adjustright {
\par }\pard \qc\widctlpar\adjustright {\b Ch\'ad\'acng III
\par }{\b\f17\fs26 ch\'d5 \'ae\'e9, ch\'ddnh s\'b8ch \'ae\'e8i v\'edi ng\'ad\'eai l\'b5m c\'abng t\'b8c
\par c\'ac y\'d5u chuy\'d3n sang l\'b5m c\'abng t\'b8c kh\'b8c
\par trong t\'e6 ch\'f8c c\'ac y\'d5u
\par 
\par }\pard \qj\fi540\widctlpar\adjustright {\b \'a7i\'d2u 11. }{Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u khi chuy\'d3n sang l\'b5m c\'abng vi\'d6c kh\'b8c trong t\'e6 ch\'f8c c\'ac y\'d5u \'ae\'ad\'eec x\'d5p l\'ad\'acng theo c\'abng vi\'d6c m\'edi.

\par 
\par }\pard \qj\fi547\sl276\slmult1\widctlpar\adjustright {M\'f8c l\'ad\'acng \'ae\'ad\'eec x\'d5p khi chuy\'d3n sang l\'b5m c\'abng t\'b8c kh\'b8c, c\'a8n c\'f8 v\'b5o ng\'b5nh ho\'c6c nh\'e3m ng\'b5nh c\'b8n b\'e9 \'ae\'ad\'eec s\'bep x\'d5p; tr\'d7nh \'ae
\'e9 h\'e4c v\'can, \'ae\'b5o t\'b9o; th\'eai gian gi\'f7 h\'d6 s\'e8 b\'cbc l\'ad\'acng hi\'d6n t\'b9i. Tr\'ad\'eang h\'eep h\'d6 s\'e8 m\'f8c l\'ad\'acng m\'edi \'ae\'ad\'eec x\'d5p th\'cap h\'acn h\'d6 s\'e8 m\'f8c l\'ad\'acng \'eb th\'eai \'aei\'d3
m tr\'ad\'edc khi chuy\'d3n sang c\'abng vi\'d6c m\'edi th\'d7 \'ae\'ad\'eec b\'b6o l\'adu h\'d6 s\'e8 ch\'aanh l\'d6ch gi\'f7a h\'d6 s\'e8 m\'f8c l\'ad\'acng \'eb th\'eai \'aei\'d3m tr\'ad\'edc khi chuy\'d3n sang c\'abng vi\'d6c m\'edi so v\'edi h\'d6 s
\'e8 m\'f8c l\'ad\'acng m\'edi cho \'ae\'d5n khi \'ae\'ad\'eec n\'a9ng l\'ad\'acng b\'bbng ho\'c6c cao h\'acn.
\par 
\par }{\b \'a7i\'d2u 12}{. Ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u \'ae\'b7 chuy\'d3n sang l\'b5m c\'abng t\'b8c kh\'b8c trong t\'e6 ch\'f8c c\'ac y\'d5u ngh\'d8 h\'adu, th\'d7 \'ae\'ad\'eec h\'ad\'ebng c\'b8c ch\'d5 \'ae\'e9 nh\'ad quy \'ae\'denh \'ae
\'e8i v\'edi ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u chuy\'d3n ng\'b5nh ngh\'d8 h\'adu t\'b9i kho\'b6n 4 \'a7i\'d2u 6 M\'f4c II Ch\'ad\'acng II Ngh\'de \'ae\'denh n\'b5y.
\par }\pard \qj\fi540\widctlpar\adjustright {
\par }\pard \qc\widctlpar\adjustright {\b 
\par Ch\'ad\'acng IV
\par }{\b\f17\fs26 X\'f6 l\'fd vi ph\'b9m
\par }\pard \fi540\widctlpar\adjustright {\b 
\par \'a7i\'d2u 13.}{ }{\b 
\par }\pard \qj\fi547\sl276\slmult1\widctlpar\adjustright {1. C\'b8c quy\'d2n l\'eei c\'f1a ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u quy \'ae\'denh t\'b9i Ngh\'de \'ae\'denh n\'b5y s\'cf b\'de c\'bet gi\'b6m, h\'f1y b\'e1 n\'d5u h\'e5 s\'ac b\'de l\'b5
m sai l\'d6ch ho\'c6c gi\'b6 m\'b9o \'ae\'d3 h\'ad\'ebng ch\'d5 \'ae\'e9; quy\'d2n l\'eei \'ae\'ad\'eec h\'ad\'ebng kh\'abng \'ae\'f3ng ph\'b8p lu\'cbt ph\'b6i \'ae\'ad\'eec ho\'b5n tr\'b6.
\par 
\par Tr\'ad\'eang h\'eep do sai l\'d6ch h\'e5 s\'ac m\'b5 ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u kh\'abng \'ae\'ad\'eec h\'ad\'ebng \'ae\'f3ng ch\'d5 \'ae\'e9 th\'d7 \'ae\'ad\'eec kh\'abi ph\'f4c quy\'d2n l\'eei theo quy \'ae\'denh.
\par 
\par 2. Ngo\'b5i bi\'d6n ph\'b8p x\'f6 l\'fd theo quy \'ae\'denh t\'b9i kho\'b6n 1 \'a7i\'d2u n\'b5y th\'d7 ng\'ad\'eai c\'e3 h\'b5nh vi l\'b5m sai l\'d6ch ho\'c6c gi\'b6 m\'b9o h\'e5 s\'ac, t\'efy theo t\'ddnh ch\'cat, m\'f8c \'ae\'e9 vi ph\'b9m c\'dfn b\'de
 x\'f6 l\'fd k\'fb lu\'cbt, x\'f6 l\'fd h\'b5nh ch\'ddnh ho\'c6c b\'de truy c\'f8u tr\'b8ch nhi\'d6m h\'d7nh s\'f9 v\'b5 ph\'b6i b\'e5i th\'ad\'eang thi\'d6t h\'b9i (n\'d5u c\'e3) theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt.
\par }\pard \qj\fi540\widctlpar\adjustright {
\par }\pard \qj\widctlpar\adjustright {
\par }\pard \qc\widctlpar\adjustright {\b Ch\'ad\'acng V
\par }{\b\f17\fs26 \'aei\'d2u kho\'b6n thi h\'b5nh
\par 
\par }\pard \qj\fi540\widctlpar\adjustright {\b \'a7i\'d2u 14. }{Ngh\'de \'ae\'denh n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh sau 15 ng\'b5y, k\'d3 t\'f5 ng\'b5y \'ae\'a8ng C\'abng b\'b8o. 
\par 
\par C\'b8c quy \'ae\'denh tr\'ad\'edc \'ae\'a9y v\'d2 ch\'d5 \'ae\'e9, ch\'ddnh s\'b8ch \'ae\'e8i v\'edi ng\'ad\'eai l\'b5m c\'abng t\'b8c c\'ac y\'d5u khi ngh\'d8 h\'adu, chuy\'d3n ng\'b5nh, th\'abi vi\'d6c, chuy\'d3n sang l\'b5m c\'b8c c\'abng vi\'d6c kh
\'b8c trong t\'e6 ch\'f8c c\'ac y\'d5u tr\'b8i v\'edi quy \'ae\'denh c\'f1a Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.
\par 
\par }{\b \'a7i\'d2u 15. }{B\'e9 N\'e9i v\'f4 ch\'f1 tr\'d7, ph\'e8i h\'eep v\'edi B\'e9 Lao \'ae\'e9ng - Th\'ad\'acng binh v\'b5 X\'b7 h\'e9i, B\'e9 T\'b5i ch\'ddnh v\'b5 Ban C\'ac y\'d5u Ch\'ddnh ph\'f1 c\'e3 tr\'b8ch nhi\'d6m h\'ad\'edng d\'c9n v\'b5 ki\'d3
m tra vi\'d6c thi  h\'b5nh Ngh\'de \'ae\'denh n\'b5y.
\par }{\b \'a7i\'d2u 16. }{C\'b8c B\'e9 tr\'ad\'ebng, Th\'f1 tr\'ad\'ebng c\'ac quan ngang B\'e9, Th\'f1 tr\'ad\'ebng c\'ac quan thu\'e9c Ch\'ddnh ph\'f1, Ch\'f1 t\'dech }{\f17 \'f1}{y ban nh\'a9n d\'a9n t\'d8nh, th\'b5nh ph\'e8 tr\'f9c thu\'e9c Trung \'ad\'ac
ng, c\'ac quan, t\'e6 ch\'f8c s\'f6 d\'f4ng c\'ac y\'d5u ch\'deu tr\'b8ch nhi\'d6m thi h\'b5nh Ngh\'de \'ae\'denh n\'b5y ./.
\par 
\par 
\par 
\par }\pard \qc\fi540\li3600\widctlpar\adjustright {\b\f17\fs26 tm. ch\'ddnh ph\'f1
