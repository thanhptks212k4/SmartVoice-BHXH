\nowidctlpar\widctlpar\intbl\adjustright {\f20 \row }\trowd \trgaph108\trleft-630 \clvertalt\cltxlrtb \cellx1980\clvertalt\cltxlrtb \cellx2300\clvertalt\cltxlrtb \cellx9450\pard \qc\nowidctlpar\widctlpar\intbl\adjustright {\i\f21\fs22 \cell }{\f20 \cell }
{\i\f21\fs22 H\'b5 N\'e9i, ng\'b5y 23  th\'b8ng  01   n\'a8m 1998}{\b\f19\fs20 \cell }\pard \nowidctlpar\widctlpar\intbl\adjustright {\f20 \row }\pard \qj\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\f21\fs26 
\par }\pard \qc\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\f21\fs26 
\par }{\b\f17\fs22 Ngh\'de \'ae\'denh c\'f1a Ch\'ddnh ph\'f1
\par }{\b\f21\fs26 S\'f6a \'ae\'e6i, b\'e6 sung Ngh\'de \'ae\'denh 50/CP ng\'b5y 26 th\'b8ng 7 n\'a8m 1995 
\par c\'f1a Ch\'ddnh ph\'f1 v\'d2 ch\'d5 \'ae\'e9 sinh ho\'b9t ph\'dd 
\par \'ae\'e8i v\'edi c\'b8n b\'e9 x\'b7, ph\'ad\'eang, th\'de tr\'can.
\par }{\f21\fs26 _____
\par 
\par }{\b\f17\fs22 ch\'ddnh ph\'f1}{\f21\fs26 
\par }\pard \qj\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\f21\fs26 
\par }\pard \qj\fi630\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\f21\fs26 C\'a8n c\'f8 Lu\'cbt T\'e6 ch\'f8c Ch\'ddnh ph\'f1 ng\'b5y 30 th\'b8ng 9 n\'a8m 1992;
\par }\pard \qj\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\f21\fs26 
\par }\pard \qj\fi720\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\f21\fs26 C\'a8n c\'f8 Ngh\'de quy\'d5t s\'e8 99/CP ng\'b5y 15 th\'b8ng 9 n\'a8m 1997 c\'f1a Ch\'ddnh ph\'f1;
\par 
\par C\'a8n c\'f8 \'fd ki\'d5n c\'f1a Th\'ad\'eang v\'f4 B\'e9 Ch\'ddnh tr\'de t\'b9i th\'abng b\'b8o                          s\'e8 32/CV-VPTW ng\'b5y 09 th\'b8ng 01 n\'a8m 1998 c\'f1a V\'a8n ph\'dfng Trung \'ad\'acng \'a7\'b6ng;
\par 
\par Theo \'ae\'d2 ngh\'de c\'f1a B\'e9 tr\'ad\'ebng, Tr\'ad\'ebng ban T\'e6 ch\'f8c - c\'b8n b\'e9 Ch\'ddnh ph\'f1,
\par }\pard \qj\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\f21\fs26 
\par }\pard \qc\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\b\f17\fs22 Ngh\'de \'ae\'denh :
\par }\pard \qj\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\f21\fs26 
\par }\pard \qj\fi720\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\b\f21\fs26 \'a7i\'d2u 1.}{\f21\fs26  Nay quy \'ae\'denh s\'e8 l\'ad\'eeng c\'b8n b\'e9 l\'b5m c\'abng t\'b8c \'ae\'b6ng, ch\'ddnh quy\'d2n, m\'c6t tr\'cbn, \'aeo\'b5n th\'d3 (H\'e9i ph\'f4
 n\'f7, H\'e9i n\'abng d\'a9n, H\'e9i c\'f9u chi\'d5n binh, \'a7o\'b5n th\'b5nh ni\'aan C\'e9ng s\'b6n H\'e5 Ch\'dd Minh) x\'b7, ph\'ad\'eang, th\'de tr\'can (g\'e4i chung l\'b5 x\'b7) \'ae\'ad\'eec h\'ad\'ebng sinh ho\'b9t ph\'dd nh\'ad sau :
\par 
\par - X\'b7 d\'ad\'edi 10.000 d\'a9n : 17 - 19 c\'b8n b\'e9.
\par - X\'b7 t\'f5 10.000 d\'a9n \'ae\'d5n 20.000 d\'a9n : 19 - 21 c\'b8n b\'e9.
\par 
\par - X\'b7 c\'e3 tr\'aan 20.000 d\'a9n, c\'f8 th\'aam 3.000 d\'a9n th\'aam 1 c\'b8n b\'e9, t\'e8i \'aea kh\'abng qu\'b8 25 c\'b8n b\'e9.
\par 
\par }{\b\f21\fs26 \'a7i\'d2u 2.}{\f21\fs26  Theo quy \'ae\'denh t\'b9i \'a7i\'d2u 1 tr\'aan \'ae\'a9y, }{\f17\fs26 \'f1}{\f21\fs26 y ban nh\'a9n d\'a9n t\'d8nh, th\'b5nh ph\'e8 tr\'f9c thu\'e9c Trung \'ad\'acng c\'a8n c\'f8 v\'b5o s\'e8 d\'a9n, di\'d6n t\'dd
ch, \'ae\'c6c \'aei\'d3m \'aei\'d2u ki\'d6n kinh t\'d5 - x\'b7 h\'e9i, v\'efng l\'b7nh th\'e6 (x\'b7 mi\'d2n n\'f3i, bi\'aan gi\'edi, h\'b6i \'ae\'b6o...), ngu\'e5n ng\'a9n s\'b8ch c\'f1a  \'ae\'dea ph\'ad\'acng v\'b5 h\'ad\'edng d\'c9n c\'f1a li\'aan B
\'e9 \'ae\'d3 quy \'ae\'denh s\'e8 l\'ad\'eeng c\'f4 th\'d3 cho th\'ddch h\'eep v\'edi t\'f5ng lo\'b9i x\'b7, trong \'ae\'e3 c\'e3 4 ch\'f8c danh chuy\'aan m\'abn : \'a7\'dea ch\'ddnh, T\'ad ph\'b8p, T\'b5i ch\'ddnh - K\'d5 to\'b8n, V\'a8n ph\'dfng }{
\f17\fs26 \'f1}{\f21\fs26 y ban  nh\'a9n d\'a9n x\'b7.
\par }{\b\f21\fs26 
\par \'a7i\'d2u 3.}{\f21\fs26  M\'f8c sinh ho\'b9t ph\'dd h\'b5ng th\'b8ng \'ae\'e8i v\'edi c\'b8n b\'e9 l\'b5m c\'abng t\'b8c \'ae\'b6ng, c\'abng t\'b8c ch\'ddnh quy\'d2n, m\'c6t tr\'cbn, \'aeo\'b5n th\'d3 nh\'ad sau :
\par 
\par 1. B\'dd th\'ad \'ae\'b6ng \'f1y x\'b7 270.000 \'ae\'e5ng/th\'b8ng.
\par 
\par 2. Ph\'e3 B\'dd th\'ad \'ae\'b6ng \'f1y x\'b7, Ch\'f1 t\'dech H\'e9i \'ae\'e5ng nh\'a9n d\'a9n x\'b7 (n\'aci B\'dd th\'ad \'ae\'b6ng \'f1y kh\'abng ki\'aam nhi\'d6m Ch\'f1 t\'dech H\'e9i \'ae\'e5ng nh\'a9n d\'a9n x\'b7), Ch\'f1 t\'dech }{\f17\fs26 \'f1}{
\f21\fs26 y ban  nh\'a9n d\'a9n x\'b7 : 260.000 \'ae\'e5ng/th\'b8ng.
\par 
\par 3. Ph\'e3 Ch\'f1 t\'dech H\'e9i \'ae\'e5ng nh\'a9n d\'a9n x\'b7, Ph\'e3 Ch\'f1 t\'dech }{\f17\fs26 \'f1}{\f21\fs26 y ban  nh\'a9n d\'a9n x\'b7, Ch\'f1 t\'dech M\'c6t tr\'cbn, Tr\'ad\'ebng c\'b8c \'aeo\'b5n th\'d3 (H\'e9i ph\'f4 n\'f7, H\'e9i n\'abng d\'a9
n, H\'e9i c\'f9u chi\'d5n binh, \'a7o\'b5n thanh ni\'aan C\'e9ng s\'b6n H\'e5 Ch\'dd Minh), x\'b7 \'ae\'e9i tr\'ad\'ebng, tr\'ad\'ebng c\'abng an x\'b7 : 240.000 \'ae\'e5ng/th\'b8ng.
\par 
\par 4. }{\f17\fs26 \'f1}{\f21\fs26 y vi\'aan }{\f17\fs26 \'f1}{\f21\fs26 y ban  nh\'a9n d\'a9n x\'b7 : 230.000 \'ae\'e5ng/th\'b8ng.
\par 
\par 5. C\'b8c ch\'f8c danh kh\'b8c thu\'e9c }{\f17\fs26 \'f1}{\f21\fs26 y ban  nh\'a9n d\'a9n : 210.000 \'ae\'e5ng/th\'b8ng.
\par 
\par Ri\'aang c\'b8n b\'e9 \'ae\'b6m nh\'cbn 4 ch\'f8c danh chuy\'aan m\'abn n\'e3i tr\'aan \'ae\'ad\'eec h\'ad\'ebng sinh ho\'b9t ph\'dd  theo ng\'b9ch b\'cbc chuy\'aan m\'abn \'ae\'b5o t\'b9o, tr\'ad\'eang h\'eep ch\'ada c\'e3 b\'bbng c\'cap chuy\'aan m\'ab
n qua \'ae\'b5o t\'b9o th\'d7 h\'ad\'ebng m\'f8c 154.000 \'ae\'e5ng/th\'b8ng.
\par 
\par 6. C\'b8c ch\'f8c danh quy \'ae\'denh t\'b9i c\'b8c \'aei\'d3m 1, 2, 3, 4, 5 c\'f1a \'a7i\'d2u 3 tr\'aan \'ae\'a9y \'ae\'ad\'eec h\'ad\'ebng ph\'f4 c\'cap th\'aam 5% m\'f8c sinh ho\'b9t ph\'dd h\'b5ng th\'b8ng \'aeang h\'ad\'ebng nh\'ad sau :
\par 
\par - \'a7\'e8i v\'edi c\'b8n b\'e9 qua b\'c7u c\'f6 \'ae\'ad\'eec t\'b8i c\'f6 t\'f5 nhi\'d6m k\'fa th\'f8 2 sau 5 n\'a8m  tr\'eb \'aei.
\par 
\par - \'a7\'e8i v\'edi 4 c\'b8n b\'e9 chuy\'aan m\'abn n\'e3i tr\'aan \'ae\'b7 \'ae\'ad\'eec h\'ad\'ebng m\'f8c sinh ho\'b9t ph\'dd theo ng\'b9ch b\'cbc chuy\'aan m\'abn \'ae\'b5o t\'b9o th\'d7 kh\'abng \'ae\'ad\'eec h\'ad\'ebng ph\'f4 c\'cap th\'aam 5%.

\par 
\par 7. \'a7\'e8i v\'edi Ph\'e3 Ch\'f1 t\'dech M\'c6t tr\'cbn T\'e6 qu\'e8c v\'b5 Ph\'e3 c\'b8c \'aeo\'b5n th\'d3 (H\'e9i ph\'f4 n\'f7, \'a7o\'b5n thanh ni\'aan C\'e9ng s\'b6n H\'e5 Ch\'dd Minh, H\'e9i n\'abng d\'a9n, H\'e9i c\'f9u chi\'d5n binh) h\'ad\'eb
ng ho\'b9t \'ae\'e9ng ph\'dd t\'f5 ngu\'e5n chi th\'ad\'eang xuy\'aan c\'f1a ng\'a9n s\'b8ch x\'b7 c\'a9n \'ae\'e8i cho m\'e7i \'aeo\'b5n th\'d3, m\'f8c chi do H\'e9i \'ae\'e5ng nh\'a9n d\'a9n t\'d8nh quy\'d5t \'ae\'denh theo \'ae\'d2 ngh\'de c\'f1a Ch
\'f1 t\'dech }{\f17\fs26 \'f1}{\f21\fs26 y ban  nh\'a9n d\'a9n t\'d8nh.
\par 
\par 
\par 
\par 
\par 
\par 8. S\'e8 c\'b8n b\'e9 thu\'e9c bi\'aan ch\'d5 Nh\'b5 n\'ad\'edc t\'a8ng c\'ad\'eang cho x\'b7 th\'d7 h\'ad\'ebng m\'e4i ch\'d5 \'ae\'e9, ch\'ddnh s\'b8ch hi\'d6n h\'b5nh nh\'ad \'ae\'e8i v\'edi c\'abng ch\'f8c Nh\'b5 n\'ad\'edc. S\'e8 c\'b8n b\'e9 t\'a8
ng c\'ad\'eang n\'b5y \'ae\'ad\'eec t\'ddnh v\'b5o t\'e6ng s\'e8 c\'b8n b\'e9 x\'b7 theo quy \'ae\'denh t\'b9i \'a7i\'d2u 1 c\'f1a Ngh\'de \'ae\'denh n\'b5y.
\par 
\par }{\b\f21\fs26 \'a7i\'d2u 4.}{\f21\fs26  C\'b8n b\'e9 x\'b7 h\'ad\'ebng sinh ho\'b9t ph\'dd thu\'e9c c\'b8c \'ae\'e8i t\'ad\'eeng quy \'ae\'denh t\'b9i \'aei\'d3m 1, 2, 3, 4, 5 \'a7i\'d2u 3 Ngh\'de \'ae\'denh n\'b5y khi ngh\'d8 vi\'d6c th\'d7 \'ae\'ad\'ee
c h\'ad\'ebng ch\'d5 \'ae\'e9 tr\'ee c\'cap nh\'ad sau :
\par 
\par a) Nam \'ae\'f1 55 tu\'e6i, n\'f7 \'ae\'f1 50 tu\'e6i, c\'e3 th\'eai gian c\'abng t\'b8c li\'aan t\'f4c 15 n\'a8m tr\'eb l\'aan, c\'e3 \'ae\'e3ng b\'b6o hi\'d3m x\'b7 h\'e9i \'ae\'f1 15 n\'a8m tr\'eb l\'aan v\'edi m\'f8c b\'bbng 15% m\'f8c sinh ho\'b9t ph
\'dd h\'b5ng th\'b8ng (trong \'ae\'e3 c\'b8n b\'e9 x\'b7 \'ae\'e3ng 5%, ng\'a9n s\'b8ch Nh\'b5 n\'ad\'edc \'ae\'e3ng 10%) th\'d7 \'ae\'ad\'eec h\'ad\'ebng ch\'d5 \'ae\'e9 tr\'ee c\'cap h\'b5ng th\'b8ng.
\par }\pard \qj\fi720\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\f21\fs26 
\par }\pard \qj\fi720\li-180\ri-79\nowidctlpar\widctlpar\adjustright {\f21\fs26 M\'f8c tr\'ee c\'cap h\'b5ng th\'b8ng c\'f1a 15 n\'a8m \'ae\'c7u b\'bbng 45% m\'f8c sinh ho\'b9t ph\'dd b\'d7nh qu\'a9n c\'f1a 5 n\'a8m cu\'e8i tr\'ad\'edc khi ngh\'d8; sau 15 n
\'a8m, c\'f8 th\'aam m\'e9t n\'a8m c\'abng t\'b8c v\'b5 c\'e3 \'ae\'e3ng b\'b6o hi\'d3m th\'d7 \'ae\'ad\'eec t\'ddnh th\'aam 2%, nh\'adng m\'f8c tr\'ee c\'cap cao nh\'cat kh\'abng qu\'b8 75% m\'f8c sinh ho\'b9t ph\'dd b\'d7nh qu\'a9n c\'f1a 5 n\'a8m cu
\'e8i tr\'ad\'edc khi ngh\'d8.
\par 
\par b) Tr\'ad\'eang h\'eep ngh\'d8 vi\'d6c ch\'ada \'ae\'f1 15 n\'a8m c\'abng t\'b8c li\'aan t\'f4c v\'b5 \'ae\'e3ng b\'b6o hi\'d3m x\'b7 h\'e9i, khi ngh\'d8 \'ae\'ad\'eec h\'ad\'ebng tr\'ee c\'cap m\'e9t l\'c7n; m\'e7i n\'a8m c\'abng t\'b8c \'ae\'ad\'eec h
\'ad\'ebng m\'e9t th\'b8ng sinh ho\'b9t ph\'dd t\'ddnh theo b\'d7nh qu\'a9n 5 n\'a8m cu\'e8i tr\'ad\'edc khi ngh\'d8 vi\'d6c.
\par 
\par Ch\'f1 t\'dech }{\f17\fs26 \'f1}{\f21\fs26 y ban  nh\'a9n d\'a9n t\'d8nh, th\'b5nh ph\'e8 tr\'f9c thu\'e9c Trung \'ad\'acng quy\'d5t \'ae\'denh \'ae\'e8i v\'edi c\'b8n b\'e9 \'ae\'ad\'eec h\'ad\'ebng c\'b8c ch\'d5 \'ae\'e9 tr\'ee c\'cap n\'e3i tr\'aan, B
\'b6o hi\'d3m x\'b7 h\'e9i Vi\'d6t Nam c\'e3 tr\'b8ch nhi\'d6m th\'f9c hi\'d6n ch\'d5 \'ae\'e9 \'ae\'e8i v\'edi c\'b8n b\'e9 x\'b7 theo Ngh\'de \'ae\'denh n\'b5y.
\par 
\par }{\b\f21\fs26 \'a7i\'d2u 5.}{\f21\fs26  C\'b8n b\'e9 x\'b7, ph\'ad\'eang, th\'de tr\'can \'ae\'ad\'eec h\'ad\'ebng c\'b8c ch\'d5 \'ae\'e9 \'ae\'b5o t\'b9o, b\'e5i d\'ad\'ecng chuy\'aan m\'abn nghi\'d6p v\'f4, c\'abng t\'b8c ph\'dd, \'ae\'ad\'eec khen th
\'ad\'ebng theo quy \'ae\'denh c\'f1a Nh\'b5 n\'ad\'edc v\'b5 ch\'d5 \'ae\'e9 mai t\'b8ng ph\'dd.
\par 
\par }{\b\f21\fs26 \'a7i\'d2u 6.}{\f21\fs26  Kinh ph\'dd \'ae\'d3 th\'f9c hi\'d6n ch\'d5 \'ae\'e9 quy \'ae\'denh t\'b9i Ngh\'de \'ae\'denh n\'b5y thu\'e9c ngu\'e5n ng\'a9n s\'b8ch Nh\'b5 n\'ad\'edc c\'a9n \'ae\'e8i v\'b5o ng\'a9n s\'b8ch x\'b7.
\par 
\par }{\b\f21\fs26 \'a7i\'d2u 7.}{\f21\fs26  Ch\'d5 \'ae\'e9 sinh ho\'b9t ph\'dd quy \'ae\'denh trong Ngh\'de \'ae\'denh n\'b5y \'ae\'ad\'eec th\'f9c hi\'d6n t\'f5 ng\'b5y 01 th\'b8ng 01 n\'a8m 1998; c\'b8c quy \'ae\'denh trong Ngh\'de \'ae\'denh    s\'e8
 50/CP ng\'b5y 26 th\'b8ng 7 n\'a8m 1995 c\'f1a Ch\'ddnh ph\'f1 v\'d2 ch\'d5 \'ae\'e9 sinh ho\'b9t ph\'dd \'ae\'e8i v\'edi c\'b8n b\'e9 x\'b7, ph\'ad\'eang, th\'de tr\'can tr\'b8i v\'edi Ngh\'de \'ae\'denh n\'b5y \'ae\'d2u b\'b7i b\'e1.
\par 
\par }{\b\f21\fs26 
\par 
\par 
\par \'a7i\'d2u 8.}{\f21\fs26  Ban T\'e6 ch\'f8c - C\'b8n b\'e9 Ch\'ddnh ph\'f1, B\'e9 T\'b5i ch\'ddnh, B\'e9 Lao \'ae\'e9ng - Th\'ad\'acng binh v\'b5 X\'b7 h\'e9i ph\'e8i h\'eep v\'edi Ban T\'e6 ch\'f8c Trung \'ad\'acng h\'ad\'edng d\'c9n th\'f9c hi\'d6n Ngh
\'de \'ae\'denh n\'b5y.
\par 
\par C\'b8c B\'e9 tr\'ad\'ebng, Th\'f1 tr\'ad\'ebng c\'ac quan ngang B\'e9, Th\'f1 tr\'ad\'ebng c\'ac quan thu\'e9c Ch\'ddnh ph\'f1, Ch\'f1 t\'dech }{\f17\fs26 \'f1}{\f21\fs26 y ban nh\'a9n d\'a9n t\'d8nh, th\'b5nh ph\'e8 tr\'f9c thu\'e9c Trung \'ad\'acng ch
\'deu tr\'b8ch nhi\'d6m thi h\'b5nh Ngh\'de \'ae\'denh n\'b5y./.
\par 
\par 
\par 
\par }\pard \qc\fi720\li3600\ri-79\nowidctlpar\widctlpar\adjustright {\b\f17\fs22 t/m. Ch\'ddnh ph\'f1
\par th\'f1 t\'ad\'edng
\par }\pard \qj\nowidctlpar\widctlpar\adjustright {\b\i\f20\fs22 N\'aci nh\'cbn :
\par }{\f20\fs20 - Th\'ad\'eang v\'f4 B\'e9 Ch\'ddnh tr\'de,
