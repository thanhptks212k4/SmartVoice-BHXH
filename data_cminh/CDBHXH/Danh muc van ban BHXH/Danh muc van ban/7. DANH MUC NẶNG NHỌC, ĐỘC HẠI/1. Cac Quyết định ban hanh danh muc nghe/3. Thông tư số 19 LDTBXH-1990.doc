\keepn\widctlpar\nooverflow\faroman\rin0\lin0\itap0\pararsid16715544 \f39\fs24\cf2\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\f37\fs22\insrsid16715544 PH\'f4 L\'f4C}{\insrsid16715544 
\par }\pard \qc \fi567\li0\ri0\sa120\sl240\slmult0\widctlpar\nooverflow\faroman\rin0\lin0\itap0 {\b\f37\fs20\expnd4\expndtw24\insrsid16715544 DANH M\'f4C NGH\'d2, C\'abNG VI\'d6C N\'c6NG NH\'e4C, \'ae\'e9C H\'b9I NGUY HI\'d3M
\par }\pard\plain \s18\qc \li0\ri0\widctlpar\nooverflow\faroman\rin0\lin0\itap0 \i\f39\fs24\cf2\lang1024\langfe1024\cgrid\noproof\langnp1033\langfenp1033 {\insrsid16715544 (Ban h\'b5nh k\'ccm theo Th\'abng t\'ad s\'e8 19-L\'a7-TBXH/TT ng\'b5y 31-12-1990 c\'f1
a B\'e9 Lao \'ae\'e9ng - Th\'ad\'acng binh v\'b5 x\'b7 h\'e9i).
\par }\pard\plain \qj \fi567\li0\ri0\sa120\sl240\slmult0\widctlpar\nooverflow\faroman\rin0\lin0\itap0 \f39\fs24\cf2\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid16715544 
\par 1. N\'cau ch\'b6y v\'b5 r\'e3t kim lo\'b9i n\'e3ng ch\'b6y,
\par 2. C\'b8n kim lo\'b9i n\'e3ng,
\par 3. Luy\'d6n qu\'c6ng kim lo\'b9i m\'b5u, (\'ae\'e5ng, ch\'d7, thu\'fb ng\'a9n, k\'cfm b\'b9c),
\par 4. C\'b8n, k\'d0o, d\'cbp s\'b6n ph\'c8m ch\'d7, s\'b6n ph\'c8m m\'b9 ch\'d7,
\par 5. \'a7\'e8t l\'df luy\'d6n c\'e8c, 6. Ph\'b8 v\'ec khu\'abn \'ae\'f3c,
\par 7. L\'b5m s\'b9ch n\'e5i h\'aci, \'e8ng d\'c9n kh\'dd,
\par 8. H\'b5n \'bec quy ch\'d7, h\'b5n trong th\'efng k\'ddn, h\'b5n \'eb v\'de tr\'dd c\'e3 \'ae\'e9 cao tr\'aan 10 m,
\par 9. T\'cat c\'b6 nh\'f7ng c\'abng vi\'d6c ph\'b6i ti\'d5p x\'f3c v\'edi ngu\'e5n ph\'e3ng x\'b9 h\'eb,
\par 10. S\'b6n xu\'cat, bao g\'e3i ho\'c6c th\'ad\'eang xuy\'aan ti\'d5p x\'f3c v\'edi anilin,
\par 11. S\'b6n xu\'cat ph\'abt-pho, asen v\'b5 h\'eep ch\'cat ch\'f8a asen,
\par 12. S\'b6n xu\'cat \'ae\'e3ng g\'e3i v\'b5 th\'ad\'eang xuy\'aan ti\'d5p x\'f3c v\'edi x\'a8ng, s\'acn, m\'f9c in c\'e3 ch\'f8a ch\'d7,
\par 13. Th\'ad\'eang xuy\'aan ti\'d5p x\'f3c v\'edi m\'a8ng-gan, di\'abxyt, thu\'fb ng\'a9n,
\par 14. \'a7\'e8t l\'df s\'cay qu\'c6ng pyr\'ddt, h\'cap th\'f4, r\'f6a tinh ch\'d5 kh\'dd v\'cbn h\'b5nh b\'acm ax\'ddt, l\'e4c b\'f4i \'aei\'d6n, th\'b6i x\'d8 (trong s\'b6n xu\'cat ax\'ddt sunfuric),
\par 15. S\'b6n xu\'cat ax\'ddt nitric v\'b5 natrisunfat,
\par 16. S\'b6n xu\'cat di sunfua cacbon,
\par 17. S\'b6n xu\'cat ph\'e8t-gien,
\par 18. Ch\'adng c\'cat, \'ae\'e3ng b\'d7nh dung m\'abi benzen v\'b5 \'ae\'e5ng \'ae\'bcng c\'f1a benzen,
\par 19. \'a7i\'d6n ph\'a9n Clo, ho\'b8 l\'e1ng Clo, \'ae\'e3ng b\'d7nh Clo, x\'f6 l\'fd Clo (trong s\'b6n xu\'cat ax\'ddt Clohy\'aeric).
\par 20. \'a7\'e8t l\'df s\'cay qu\'c6ng, nghi\'d2n m\'den, \'aei\'d2u ch\'d5 supe ph\'e8t ph\'b8t (trong supe ph\'e8t ph\'b8t),
\par 21. V\'cbn h\'b5nh l\'df t\'b9o kh\'dd than, th\'b6i x\'d8 l\'b5 t\'b9o kh\'dd than, t\'b8i sinh dung d\'dech \'ae\'e5ng, v\'cbn h\'b5nh m\'b8y n\'d0n ur\'aa (trong s\'b6n xu\'cat ph\'a9n \'ae\'b9m ur\'aa). 22. V\'cbn h\'b5nh l\'df s\'b6n xu\'cat \'ae\'ca
t \'ae\'ccn d\'b9ng h\'eb, nghi\'d2n \'ae\'cat \'ae\'ccn th\'f1 c\'abng,
\par 23. T\'b8i sinh ch\'d7, n\'cau h\'eep kim ch\'d7, \'ae\'f3c bi ch\'d7, \'ae\'f3c s\'ad\'ean c\'f4c ch\'d7, tr\'e9n tr\'b8t cao l\'b8 c\'f9c (trong s\'b6n xu\'cat \'bec quy).
\par 24. S\'b6n xu\'cat bao g\'e3i ho\'c6c th\'ad\'eang xuy\'aan ti\'d5p x\'f3c v\'edi c\'b8c lo\'b9i thu\'e8c tr\'f5 s\'a9u, di\'d6t c\'e1, di\'d6t chu\'e9t, s\'b8t tr\'efng, ch\'e8ng m\'e8i m\'e4t c\'e3 t\'ddnh \'ae\'e9c m\'b9nh nh\'ad:
\par + Asen v\'b5 mu\'e8i c\'f1a asen,
\par + Ph\'e8t fua k\'cfm, ph\'e8t fua nh\'abm, ph\'e8t fua hy\'aer\'ab,
\par + Ax\'ddt flo, ax\'ddt Clohy\'aeric, ax\'ddt Xyahy\'aeric v\'b5 mu\'e8i c\'f1a ax\'ddt xyanhy\'aeric,
\par + Clopicrin,
\par + Nitro benzen,
\par + Thu\'fb ng\'a9n h\'f7u c\'ac (simen, x\'aa-r\'aa-sen...),
\par + L\'a9n h\'f7u c\'ac (Etylparation, metylparation...),
\par + Clo h\'f7u c\'ac (DDT c\'b8c lo\'b9i, 666 c\'b8c lo\'b9i).
\par 25. S\'f6a ch\'f7a thi\'d5t b\'de ho\'b8 ch\'cat nh\'ad: s\'f6a ch\'f7a l\'df, th\'efng, th\'b8p k\'ddn, \'ae\'ad\'eang \'e8ng ng\'c7m.
\par 26. Ph\'e8i li\'d6u, c\'a9n \'aeong, s\'b5ng s\'c8y ho\'b8 ch\'cat trong s\'b6n xu\'cat cao su.
\par 27. L\'adu ho\'b8, h\'d7nh th\'b5nh, b\'e8c d\'ec s\'b6n ph\'c8m cao su c\'ec l\'edn nh\'ad: th\'efng, k\'d0t nhi\'aan li\'d6u, l\'e8p \'ab-t\'ab...
\par 28. L\'b5m vi\'d6c trong l\'df x\'abng m\'f1 cao su.
\par 29. \'a7\'b5o l\'df, \'ae\'b5o l\'df gi\'d5ng,
\par 30. T\'cat c\'b6 c\'abng vi\'d6c trong h\'c7m l\'df k\'d3 c\'b6 v\'cbn chuy\'d3n,
\par 31. Khoan th\'a8m d\'df, khoan n\'e6 m\'d7n, b\'ben m\'d7n,
\par 32. Nghi\'d2n, ph\'e8i li\'d6u qu\'c6ng, nguy\'aan li\'d6u trong \'aei\'d2u ki\'d6n b\'f4i t\'b9o th\'b5nh ch\'f8a t\'f5 10% \'aei\'abxyt silic tr\'eb l\'aan.
\par 33. Tuy\'d3n kho\'b8ng ch\'d7.
\par 34. Khai th\'b8c qu\'c6ng ph\'e3ng x\'b9 c\'b8c lo\'b9i.
\par 35. L\'bep \'ae\'c6t gi\'b5n khoan,
\par 36. Khoan th\'a8m d\'df gi\'d5ng d\'c7u v\'b5 kh\'dd,
\par 37. L\'b5m vi\'d6c \'eb h\'d6 th\'e8ng thi\'d5t b\'de khoan n\'e6i tr\'aan bi\'d3n.
\par 38. Th\'ee l\'c6n d\'c7u kh\'dd
\par 39. L\'b8i m\'b8y bay tr\'f9c th\'a8ng cho c\'b8c gi\'b5n khoan
\par 40. S\'f6a ch\'f7a \'ae\'ad\'eang c\'b8p c\'e3 m\'b9 ch\'d7 h\'b5n h\'e9p c\'b8p ch\'d7,
\par 41. S\'f6a ch\'f7a \'ae\'ad\'eang d\'a9y \'aei\'d6n cao th\'d5, d\'f9ng c\'e9t \'aei\'d6n cao th\'d5,
\par 42. X\'a9y d\'f9ng, s\'f6a ch\'f7a c\'e9t cao qua s\'abng, c\'e9t \'a8ngten,
\par 43. X\'a9y d\'f9ng, s\'f6a ch\'f7a c\'b8p ng\'c7m th\'abng tin,
\par 44. Pha ch\'d5 Clo,
\par 45. Th\'ad\'eang xuy\'aan tr\'f9c ti\'d5p v\'edi hypoclor\'ddt,
\par 46. Th\'ad\'eang xuy\'aan pha ch\'d5, tr\'f9c ti\'d5p v\'edi thu\'e8c nhu\'e9m anilin,
\par 47. N\'cau thu\'fb tinh, th\'e6i thu\'fb tinh b\'bbng mi\'d6ng,
\par 48. M\'b9 Cr\'abm, m\'b9 xyanua,
\par 49. V\'cbn h\'b5nh n\'e5i da t\'f4 keo ph\'aanon, c\'b8n \'d0p nh\'f9a ph\'aanon,
\par 50. In hoa tr\'aan m\'b5ng m\'e1ng, in nh\'b7n tr\'aan gi\'cay m\'b5ng m\'e1ng,
\par 51. V\'cbn h\'b5nh m\'b8y h\'e5 v\'b6i s\'eei, 52. Tr\'b6i nh\'f2 t\'ad\'acng gi\'cay \'b6nh,
\par 53. Ng\'cam t\'c8m da, mu\'e8i da,
\par 54. B\'e3c d\'ec da s\'e8ng,
\par 55. C\'b8n \'d0p t\'cam da l\'edn, c\'f8ng,
\par 56. L\'b5m vi\'d6c \'eb l\'df l\'aan men thu\'e8c l\'b8,
\par 57. Tr\'b8ng parafin trong b\'d3 r\'ad\'eeu, 58. V\'b5o h\'e9p s\'f7a trong bu\'e5ng k\'ddn,
\par 59. S\'acn, c\'b9o r\'d8 trong h\'c7m men bia,
\par 60. Ng\'a9m, v\'edt b\'e9t thu\'e8c th\'e8i.
\par 61. L\'b5m vi\'d6c trong th\'efng ch\'d7m,
\par 62. C\'a8n ch\'d8nh trong thi c\'abng t\'cam l\'edn,
\par 63. \'a7\'b5o gi\'d5ng,
\par 64. C\'cby b\'c8y \'ae\'b8 tr\'aan n\'f3i,
\par 65. S\'f6 d\'f4ng c\'b8c lo\'b9i m\'b8y c\'c7m tay ch\'b9y b\'bbng h\'aci \'d0p, c\'e3 s\'f8c \'d0p t\'f5 4 \'b8t-m\'e8t-phe tr\'eb l\'aan (nh\'ad m\'b8y khoan, m\'b8y b\'f3a...),
\par 66. Bu\'e9c t\'b6i tr\'e4ng cho m\'b8y tr\'f4c,
\par 67. L\'b8i m\'b5y thi c\'abng h\'b9ng n\'c6ng c\'e3 c\'abng su\'cat l\'edn h\'acn 36 m\'b7 l\'f9c nh\'ad m\'b8y
\par x\'f3c, m\'b8y \'f1i, xe b\'b8nh x\'ddch,
\par 68. \'a7\'e8t l\'df \'ae\'c7u m\'b8y h\'aci n\'ad\'edc,
\par 69. L\'b8i xe l\'f6a,
\par 70. L\'b5m s\'b9ch n\'e5i h\'aci,
\par 71. S\'acn, h\'b5n, c\'b9o r\'d8 trong th\'efng k\'ddn,
\par 72. Ng\'a9m t\'c8m t\'b5 v\'d1t,
\par 73. Mang v\'b8c n\'c6ng tr\'aan 50 kg,
\par 74. \'a7\'e8t l\'df tr\'aan t\'c7u thu\'fb,
\par 75. V\'cbn h\'b5nh n\'e5i h\'aci,
\par 76. L\'b8i c\'c8u n\'e6i,
\par 77. G\'b9t than d\'ad\'edi h\'c7m t\'c7u,
\par 78. C\'b8n, r\'ccn, g\'df v\'e1 t\'c7u, l\'bep v\'e1 t\'c7u,
\par 79. \'a7\'e6 b\'aa-t\'abng d\'ad\'edi n\'ad\'edc,
\par 80. Kh\'b6o s\'b8t \'ae\'ad\'eang s\'abng,
\par 81. V\'cbn h\'b5nh t\'c7u h\'f3t b\'efn,
\par 82. Th\'ee l\'c6n,
\par 83. L\'b8i \'ab-t\'ab c\'e3 tr\'e4ng t\'b6i tr\'aan 2,5 t\'can
\par 84. N\'cau ch\'b6y ch\'d7, r\'e3t v\'b5 ho\'b5n thi\'d6n b\'b6n \'ae\'f3c ch\'f7 ch\'d7,
\par 85. R\'f6a ax\'ddt khu\'abn in s\'a9u.
\par 86. \'a7\'b8nh b\'bet c\'b8 t\'abm v\'b5 c\'b8c h\'b6i s\'b6n kh\'b8c tr\'aan bi\'d3n,
\par 87. Ch\'d5 bi\'d5n l\'abng v\'f2,
\par 88. Ch\'a8n tr\'a9u b\'df tr\'aan n\'f3i cao,
\par 89. Thu mua v\'cbn chuy\'d3n tr\'a9u b\'df,
\par 90. L\'b8i m\'b8y k\'d0o n\'abng nghi\'d6p 50 m\'b7 l\'f9c tr\'eb l\'aan.
\par 91. Ch\'c6t h\'b9 g\'e7 l\'edn,
\par 92. V\'cbn xu\'cat g\'e7 l\'edn,
\par 93. Xeo b\'b8n, b\'e8c x\'d5p g\'e7 l\'edn b\'bbng th\'f1 c\'abng,
\par 94. Xu\'abi b\'cc m\'b6ng tr\'aan s\'abng c\'e3 nhi\'d2u gh\'d2nh th\'b8c,
\par 95. C\'ada x\'ce g\'e7 th\'f1 c\'abng 2 ng\'ad\'eai k\'d0o
\par 96. M\'df v\'edt g\'e7 ch\'d7m,
\par 97. Giao nh\'cbn b\'b6o qu\'b6n x\'a8ng d\'c7u trong hang h\'c7m,
\par 98. V\'cbn h\'b5nh m\'b8y b\'acm x\'a8ng d\'c7u trong hang h\'c7m,
\par 99. \'a7o x\'a8ng d\'c7u trong hang h\'c7m,
\par 100. N\'b9o v\'d0t c\'e8ng ng\'c7m,
\par 101. Ng\'a9m m\'d7nh d\'ad\'edi n\'ad\'edc b\'c8n h\'abi th\'e8i,
\par 102. M\'e6 t\'f6 thi, li\'d6m, mai t\'b8ng ng\'ad\'eai ch\'d5t, b\'e8c m\'e5 m\'b6.
\par }\pard \qj \fi567\li0\ri0\sa120\widctlpar\nooverflow\faroman\rin0\lin0\itap0 {\insrsid16715544 
\par }}