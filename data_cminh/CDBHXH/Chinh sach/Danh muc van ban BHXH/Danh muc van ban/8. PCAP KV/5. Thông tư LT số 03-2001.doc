\clvertalt\clbrdrt\brdrs\brdrw10 \clbrdrl\brdrs\brdrw10 \clbrdrb\brdrs\brdrw10 \clbrdrr\brdrs\brdrw10 \cltxlrtb\clftsWidth3\clwWidth2700\clshdrawnil \cellx5220\clvertalt\clbrdrt\brdrs\brdrw10 \clbrdrl\brdrs\brdrw10 \clbrdrb\brdrs\brdrw10 \clbrdrr
\brdrs\brdrw10 \cltxlrtb\clftsWidth3\clwWidth3240\clshdrawnil \cellx8460\row }\pard\plain \s20\qj \fi720\li0\ri-284\sb120\sa80\keep\widctlpar\faauto\adjustright\rin-284\lin0\itap0 \f39\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {
\insrsid12861867 2. C\'a8n c\'f8 v\'b5o c\'b8c y\'d5u t\'e8 x\'b8c \'ae\'denh v\'b5 m\'f8c ph\'f4 c\'cap khu v\'f9c n\'aau tr\'aan, sau khi trao \'ae\'e6i \'fd ki\'d5n v\'edi U\'fb ban Nh\'a9n d\'a9n t\'d8nh, th\'b5nh ph\'e8 tr\'f9c thu\'e9c Trung \'ad
\'acng v\'b5 m\'e9t s\'e8 B\'e9, ng\'b5nh li\'aan quan, Li\'aan B\'e9 ban h\'b5nh danh m\'f4c c\'b8c \'ae\'dea b\'b5n x\'b7 v\'b5 m\'e9t s\'e8 \'ae\'acn v\'de \'ae\'ad\'eec h\'ad\'ebng ph\'f4 c\'cap khu v\'f9c t\'b9i ph\'f4 l\'f4c 1 k\'ccm theo Th\'abng t
\'ad n\'b5y.
\par }\pard\plain \s17\qj \li0\ri-340\sb80\sa80\widctlpar\faauto\adjustright\rin-340\lin0\itap0 \f39\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid12861867 \tab Trong t\'d7nh h\'d7nh th\'f9c t\'d5 hi\'d6n nay, \'ae\'d3 t\'b9o \'aei\'d2u ki
\'d6n thu\'cbn l\'eei cho vi\'d6c th\'f9c hi\'d6n \'aei\'d2u ch\'d8nh ph\'f4 c\'cap khu v\'f9c, \'ae\'e8i v\'edi c\'b8c x\'b7 ho\'c6c \'ae\'acn v\'de c\'e3 \'aei\'d2u ch\'d8nh gi\'b6m ph\'f4 c\'cap khu v\'f9c th\'d7 \'ae\'ad\'eec b\'b6o l\'adu m\'f8c ph
\'f4 c\'cap khu v\'f9c \'aeang th\'f9c hi\'d6n theo quy \'ae\'denh t\'b9i Th\'abng t\'ad s\'e8 15/L\'a7TBXH-TT ng\'b5y 2/6/1993 c\'f1a B\'e9 Lao \'ae\'e9ng-Th\'ad\'acng binh v\'b5 X\'b7 h\'e9i (ph\'f4 l\'f4c 2 k\'ccm theo) trong th\'eai gian 1 n\'a8m, k
\'d3 t\'f5 ng\'b5y 01/01/2001 \'ae\'d5n ng\'b5y 31/12/2001. T\'f5 ng\'b5y 1/1/2002 h\'ad\'ebng theo m\'f8c ph\'f4 c\'cap m\'edi quy \'ae\'denh t\'b9i ph\'f4 l\'f4c 1 c\'f1a Th\'abng t\'ad n\'b5y.
\par }\pard\plain \qj \fi720\li0\ri-283\sb80\sa80\keep\widctlpar\faauto\adjustright\rin-283\lin0\itap0 \f39\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid12861867  }{\b\i\insrsid12861867 C. C\'b8ch t\'ddnh tr\'b6 ph\'f4 c\'cap khu v\'f9c:

\par }{\insrsid12861867 1. Ph\'f4 c\'cap khu v\'f9c \'ae\'ad\'eec x\'b8c \'ae\'denh, t\'ddnh tr\'b6 theo n\'aci l\'b5m vi\'d6c \'ae\'e8i v\'edi nh\'f7ng ng\'ad\'eai t\'b9i ch\'f8c; \'ae\'ad\'eec x\'b8c \'ae\'denh, t\'ddnh to\'b8n, chi tr\'b6 theo n\'aci \'ae
\'a8ng k\'fd th\'ad\'eang tr\'f3 v\'b5 nh\'cbn l\'ad\'acng h\'adu, tr\'ee c\'cap thay l\'ad\'acng \'ae\'e8i v\'edi ng\'ad\'eai ngh\'d8 h\'adu v\'b5 ng\'ad\'eai h\'ad\'ebng tr\'ee c\'cap theo quy \'ae\'denh.
\par 2. Ph\'f4 c\'cap khu v\'f9c \'ae\'ad\'eec tr\'b6 c\'efng k\'fa l\'ad\'acng, tr\'ee c\'cap h\'bbng th\'b8ng. \'a7\'e8i v\'edi c\'b8c \'ae\'e8i t\'ad\'eeng h\'ad\'ebng l\'ad\'acng v\'b5 tr\'ee c\'cap theo quy \'ae\'denh t\'f5 ng\'a9n s\'b8ch Nh\'b5 n\'ad
\'edc, ph\'f4 c\'cap khu v\'f9c do ng\'a9n s\'b8ch Nh\'b5 n\'ad\'edc chi tr\'b6 theo ph\'a9n c\'cap ng\'a9n s\'b8ch hi\'d6n h\'b5nh: \'ae\'acn v\'de \'ae\'dea ph\'ad\'acng qu\'b6n l\'fd do ng\'a9n s\'b8ch \'ae\'dea ph\'ad\'acng \'ae\'b6m b\'b6o; \'ae\'ac
n v\'de Trung \'ad\'acng qu\'b6n l\'fd do ng\'a9n s\'b8ch Trung \'ad\'acng \'ae\'b6m b\'b6o trong d\'f9 to\'b8n ng\'a9n s\'b8ch \'ae\'ad\'eec giao h\'bbng n\'a8m cho \'ae\'acn v\'de. 
\par \'a7\'e8i v\'edi doanh nghi\'d6p, ph\'f4 c\'cap khu v\'f9c \'ae\'ad\'eec t\'ddnh v\'b5o \'ae\'acn gi\'b8 ti\'d2n l\'ad\'acng v\'b5 h\'b9ch to\'b8n v\'b5o gi\'b8 th\'b5nh ho\'c6c ph\'dd l\'adu th\'abng.
\par 3. Tr\'ad\'eang h\'eep \'aei c\'abng t\'b8c, \'aei h\'e4c, \'aei\'d2u tr\'de, \'aei\'d2u d\'ad\'ecng th\'eai h\'b9n t\'f5 1 th\'b8ng tr\'eb l\'aan th\'d7 h\'ad\'ebng ph\'f4 c\'cap khu v\'f9c theo m\'f8c quy \'ae\'denh \'eb n\'aci \'ae\'d5n c\'abng t\'b8
c, h\'e4c t\'cbp, \'aei\'d2u tr\'de, \'aei\'d2u d\'ad\'ecng; N\'aci m\'edi \'ae\'d5n kh\'abng c\'e3 ph\'f4 c\'cap khu v\'f9c th\'d7 th\'abi h\'ad\'ebng ph\'f4 c\'cap khu v\'f9c \'eb n\'aci tr\'ad\'edc khi \'aei.
\par }{\b\f37\fs26\insrsid12861867  }{\b\f37\fs24\insrsid12861867 IV. t\'e6 ch\'f8c th\'f9c hi\'d6n.
\par }{\insrsid12861867 U\'fb ban Nh\'a9n d\'a9n t\'d8nh, th\'b5nh ph\'e8 tr\'f9c thu\'e9c Trung \'ad\'acng, Th\'f1 tr\'ad\'ebng c\'b8c B\'e9, ng\'b5nh c\'a8n c\'f8 v\'b5o danh m\'f4c c\'b8c \'ae\'dea b\'b5n x\'b7 v\'b5 m\'e9t s\'e8 \'ae\'acn v\'de \'ae\'ad
\'eec h\'ad\'ebng m\'f8c ph\'f4 c\'cap khu v\'f9c \'ae\'d3 t\'e6 ch\'f8c th\'f9c hi\'d6n. Tr\'ad\'eang h\'eep c\'c7n \'aei\'d2u ch\'d8nh ho\'c6c b\'e6 sung ph\'f4 c\'cap khu v\'f9c ph\'b6i b\'b6o \'ae\'b6m c\'b8c y\'aau c\'c7u sau:
\par }\pard\plain \s17\qj \fi720\li0\ri-283\sb80\sa80\keep\widctlpar\faauto\adjustright\rin-283\lin0\itap0 \f39\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid12861867 1. Tr\'aan nguy\'aan t\'bec qu\'b6n l\'fd theo l\'b7nh th\'e6, c\'b8c c\'ac
 quan, \'ae\'acn v\'de \'ae\'e3ng t\'b9i \'ae\'dea ph\'ad\'acng c\'e3 v\'a8n b\'b6n g\'f6i U\'fb ban Nh\'a9n d\'a9n c\'cap huy\'d6n v\'b5 U\'fb ban Nh\'a9n d\'a9n c\'cap huy\'d6n c\'e3 tr\'b8ch nhi\'d6m \'ae\'d2 ngh\'de U\'fb ban Nh\'a9n d\'a9n t\'d8
nh, th\'b5nh ph\'e8 tr\'f9c thu\'e9c Trung \'ad\'acng xem x\'d0t, c\'a9n \'ae\'e8i t\'e6ng h\'eep, sau \'ae\'e3 c\'e3 v\'a8n b\'b6n g\'f6i Li\'aan t\'dech B\'e9 Lao \'ae\'e9ng-Th\'ad\'acng binh v\'b5 X\'b7 h\'e9i - B\'e9 T\'b5i ch\'ddnh - U\'fb ban D\'a9
n t\'e9c v\'b5 Mi\'d2n n\'f3i xem x\'d0t, quy\'d5t \'ae\'denh.
\par }\pard\plain \qj \fi720\li0\ri-283\sb80\sa80\keep\widctlpar\faauto\adjustright\rin-283\lin0\itap0 \f39\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid12861867 Ri\'aang c\'b8c c\'ac quan, \'ae\'acn v\'de, doanh nghi\'d6p tr\'f9c thu\'e9c c
\'b8c B\'e9, ng\'b5nh \'ae\'e3ng xa d\'a9n ho\'c6c gi\'b8p ranh v\'edi nhi\'d2u x\'b7 th\'d7 do Th\'f1 tr\'ad\'ebng c\'b8c B\'e9, ng\'b5nh \'ae\'d2 ngh\'de Li\'aan B\'e9 xem x\'d0t, c\'a9n \'ae\'e8i chung.
\par 2. H\'e5 s\'ac \'ae\'d2 ngh\'de \'ae\'ad\'eec gi\'b6i quy\'d5t h\'ad\'ebng ph\'f4 c\'cap khu v\'f9c g\'e5m c\'b8c n\'e9i dung sau:
\par }\pard\plain \s20\qj \fi720\li0\ri-284\sb80\sa80\keep\widctlpar\faauto\adjustright\rin-284\lin0\itap0 \f39\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid12861867 a. Ph\'b9m vi \'ae\'d2 ngh\'de h\'ad\'ebng ph\'f4 c\'cap khu v\'f9c (x\'b7
, ph\'ad\'eang, th\'de tr\'can, th\'b5nh ph\'e8 thu\'e9c t\'d8nh): thuy\'d5t minh v\'b5 ph\'a9n \'ae\'denh r\'e2 \'ae\'dea gi\'edi h\'b5nh ch\'ddnh  c\'f1a \'ae\'acn v\'de \'ae\'d2 ngh\'de h\'ad\'ebng ph\'f4 c\'cap khu v\'f9c, v\'cf b\'b6n \'ae\'e5 \'ae
\'dea gi\'edi h\'b5nh ch\'ddnh x\'b7 v\'edi \'ae\'ad\'eang giao th\'abng thu\'fb, b\'e9, \'ae\'e9 cao so v\'edi m\'c6t n\'ad\'edc bi\'d3n.
\par }\pard\plain \qj \fi720\li0\ri-283\sb80\sa80\keep\widctlpar\faauto\adjustright\rin-283\lin0\itap0 \f39\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid12861867  b. Thuy\'d5t minh c\'f4 th\'d3 c\'b8c y\'d5u t\'e8 li\'aan quan \'ae\'d5n vi
\'d6c x\'b8c \'ae\'denh h\'ad\'ebng ph\'f4 c\'cap khu v\'f9c, m\'f8c ph\'f4 c\'cap khu v\'f9c \'aeang h\'ad\'ebng c\'f1a c\'b8c x\'b7 l\'a9n c\'cbn (n\'d5u c\'e3) v\'b5 m\'f8c \'ae\'d2 ngh\'de \'ae\'ad\'eec \'b8p d\'f4ng.
\par c. D\'f9 t\'ddnh s\'e8 \'ae\'e8i t\'ad\'eeng h\'ad\'ebng ph\'f4 c\'cap khu v\'f9c tr\'aan \'ae\'dea b\'b5n v\'b5 nhu c\'c7u kinh ph\'dd \'ae\'d3 th\'f9c hi\'d6n vi\'d6c \'aei\'d2u ch\'d8nh ho\'c6c b\'e6 sung ph\'f4 c\'cap khu v\'f9c cho c\'b8c \'ae\'e8i t
\'ad\'eeng c\'e3 li\'aan quan tr\'aan \'ae\'dea b\'b5n (trong \'ae\'e3 t\'ddnh ri\'aang cho s\'e8 \'ae\'e8i t\'ad\'eeng h\'ad\'ebng l\'ad\'acng, tr\'ee c\'cap t\'f5 ng\'a9n s\'b8ch nh\'b5 n\'ad\'edc).
\par S\'eb Lao \'ae\'e9ng-Th\'ad\'acng binh v\'b5 X\'b7 h\'e9i ch\'f1 tr\'d7 ph\'e8i h\'eep v\'edi S\'eb T\'b5i ch\'ddnh v\'cbt gi\'b8, Ban d\'a9n t\'e9c v\'b5 Mi\'d2n n\'f3i v\'b5 c\'b8c c\'ac quan li\'aan quan gi\'f3p U\'fb ban Nh\'a9n d\'a9n t\'d8nh, th\'b5
nh ph\'e8 tr\'f9c thu\'e9c Trung \'ad\'acng t\'e6 ch\'f8c vi\'d6c th\'f9c hi\'d6n Th\'abng t\'ad n\'b5y v\'b5 \'ae\'d2 ngh\'de Li\'aan B\'e9 xem x\'d0t \'aei\'d2u ch\'d8nh ph\'f4 c\'cap khu v\'f9c khi ph\'b8t sinh.
\par }\pard\plain \s17\qj \fi720\li0\ri-283\sb80\sa80\keep\widctlpar\faauto\adjustright\rin-283\lin0\itap0 \f39\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid12861867  Th\'abng t\'ad n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh t\'f5 ng\'b5
y 01/01/2001, thay th\'d5 Th\'abng t\'ad s\'e8 15/L\'a7TBXH-TT ng\'b5y 2/6/1993 c\'f1a B\'e9 Lao \'ae\'e9ng-Th\'ad\'acng binh v\'b5 X\'b7 h\'e9i h\'ad\'edng d\'c9n th\'f9c hi\'d6n ch\'d5 \'ae\'e9 ph\'f4 c\'cap khu v\'f9c.
\par }\pard\plain \qj \li0\ri-283\sb80\sa80\keep\widctlpar\faauto\adjustright\rin-283\lin0\itap0 \f39\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\insrsid12861867 \tab Trong qu\'b8 tr\'d7nh th\'f9c hi\'d6n n\'d5u c\'e3 v\'ad\'edng m\'bec, \'ae\'d2
 ngh\'de c\'b8c B\'e9, ng\'b5nh, \'ae\'dea ph\'ad\'acng ph\'b6n \'b8nh v\'d2 Li\'aan B\'e9 \'ae\'d3 xem x\'d0t, gi\'b6i quy\'d5t./.
\par 
