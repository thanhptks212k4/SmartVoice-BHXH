\par }\pard \qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 9.}{\fs28\cf0\insrsid9532946  V\'d2 thu\'d5 nh\'b5, \'ae\'cat}{\b\fs28\cf0\insrsid9532946  
\par }{\fs28\cf0\insrsid9532946 
\par 1. C\'ac s\'eb ngo\'b5i c\'abng l\'cbp \'ae\'ad\'eec giao \'ae\'cat \'ae\'d3 s\'f6 d\'f4ng cho c\'b8c m\'f4c \'ae\'ddch quy \'ae\'denh t\'b9i kho\'b6n 1 \'a7i\'d2u 7 Ngh\'de \'ae\'denh n\'b5y, kh\'abng ph\'b6i n\'e9p thu\'d5 nh\'b5, \'ae\'cat. 
\par 
\par }\pard\plain \s20\qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\insrsid9532946 2. C\'b8c tr\'ad\'eang h\'eep kh\'b8c \'ae\'ad\'eec Nh\'b5 n\'ad\'edc giao \'ae\'cat th\'d7 th
\'f9c hi\'d6n n\'e9p thu\'d5 nh\'b5, \'ae\'cat theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt hi\'d6n h\'b5nh. 
\par }\pard\plain \qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs28\cf0\insrsid9532946  
\par }{\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 10. }{\fs28\cf0\insrsid9532946 V\'d2 l\'d6 ph\'dd tr\'ad\'edc b\'b9}{\b\fs28\cf0\insrsid9532946 
\par }\pard \qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par C\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp \'ae\'ad\'eec mi\'d4n l\'d6 ph\'dd tr\'ad\'edc b\'b9 khi \'ae\'a8ng k\'fd quy\'d2n s\'f6 d\'f4ng \'ae\'cat, quy\'d2n s\'eb h\'f7u nh\'b5.
\par 
\par }{\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 11. }{\fs28\cf0\insrsid9532946 V\'d2 thu\'d5 gi\'b8 tr\'de gia t\'a8ng}{\b\fs28\cf0\insrsid9532946 
\par }{\fs28\cf0\insrsid9532946 
\par C\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp kh\'abng ph\'b6i n\'e9p thu\'d5 gi\'b8 tr\'de gia t\'a8ng \'ae\'e8i v\'edi c\'b8c ho\'b9t \'ae\'e9ng sau : 
\par }\pard \qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par }\pard \qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 1. Ho\'b9t \'ae\'e9ng y t\'d5 : kh\'b8m b\'d6nh, ch\'f7a b\'d6nh, ph\'dfng d\'dech b\'d6nh, \'aei\'d2u d\'ad\'ecng s\'f8c kho\'ce cho ng\'ad
\'eai. 
\par 
\par 2. Ho\'b9t \'ae\'e9ng v\'a8n ho\'b8, tri\'d3n l\'b7m v\'b5 th\'d3 d\'f4c th\'d3 thao mang t\'ddnh phong tr\'b5o, qu\'c7n ch\'f3ng, t\'e6 ch\'f8c luy\'d6n t\'cbp, thi \'ae\'cau kh\'abng thu ti\'d2n ho\'c6c c\'e3 thu ti\'d2n nh\'adng kh\'abng nh\'bbm m\'f4
c \'ae\'ddch kinh doanh. 
\par 
\par }\pard \qj \fi547\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 3. Ho\'b9t \'ae\'e9ng bi\'d3u di\'d4n ngh\'d6 thu\'cbt nh\'ad : ca, m\'f3a, nh\'b9c, k\'dech, xi\'d5c; ho\'b9t \'ae\'e9ng bi\'d3u di\'d4n ngh\'d6 thu\'cb
t kh\'b8c v\'b5 d\'dech v\'f4 t\'e6 ch\'f8c bi\'d3u di\'d4n ngh\'d6 thu\'cbt; s\'b6n xu\'cat phim c\'b8c lo\'b9i.
\par }\pard \qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par }\pard\plain \s20\qj \fi547\li0\ri0\sl288\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\insrsid9532946 Ho\'b9t \'ae\'e9ng ph\'b8t h\'b5nh v\'b5 chi\'d5u phim : \'ae\'e8i v\'edi phim nh
\'f9a kh\'abng ph\'a9n bi\'d6t ch\'f1 \'ae\'d2 lo\'b9i phim, \'ae\'e8i v\'edi phim video ch\'d8 l\'b5 phim t\'b5i li\'d6u, ph\'e3ng s\'f9, khoa h\'e4c. 
\par }\pard\plain \qj \fi547\li0\ri0\sl288\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs28\cf0\insrsid9532946 
\par 4. D\'b9y h\'e4c, d\'b9y ngh\'d2 bao g\'e5m c\'b6 d\'b9y v\'a8n ho\'b8, ngo\'b9i ng\'f7, tin h\'e4c v\'b5 d\'b9y c\'b8c ngh\'d2 kh\'b8c. 
\par 
\par 5. In, xu\'cat b\'b6n v\'b5 ph\'b8t h\'b5nh : b\'b8o, t\'b9p ch\'dd, b\'b6n tin chuy\'aan ng\'b5nh, s\'b8ch ch\'ddnh tr\'de, s\'b8ch gi\'b8o khoa, gi\'b8o tr\'d7nh, s\'b8ch v\'a8n b\'b6n ph\'b8p lu\'cbt, s\'b8ch in b\'bbng ti\'d5ng d\'a9n t\'e9c thi\'d3u 
s\'e8; tranh \'b6nh, \'b8p ph\'ddch, tuy\'aan truy\'d2n, c\'e6 \'ae\'e9ng. 
\par 
\par 6. Chuy\'d3n giao c\'abng ngh\'d6 (kh\'abng bao g\'e5m gi\'b8 tr\'de thi\'d5t b\'de, m\'b8y m\'e3c thi\'d5t b\'de k\'ccm theo c\'abng ngh\'d6 \'ae\'ad\'eec chuy\'d3n giao). 
\par 
\par }{\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 12.}{\fs28\cf0\insrsid9532946  V\'d2 thu\'d5 thu nh\'cbp doanh nghi\'d6p
\par 
\par 1. V\'d2 thu\'d5 su\'cat : 
\par 
\par }\pard\plain \s19\qj \fi547\li0\ri0\sl281\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\insrsid9532946 a) C\'ac s\'eb ngo\'b5i c\'abng l\'cbp trong c\'b8c l\'dcnh v\'f9c gi\'b8o d\'f4
c, y t\'d5, v\'a8n ho\'b8, th\'d3 thao c\'e3 c\'b8c ho\'b9t \'ae\'e9ng : d\'b9y h\'e4c; d\'b9y ngh\'d2; kh\'b8m b\'d6nh, ch\'f7a b\'d6nh, bi\'d3u di\'d4n ca, m\'f3a, nh\'b9c d\'a9n t\'e9c, ngh\'d6 thu\'cbt d\'a9n t\'e9c, chi\'d5u phim; s\'adu t\'c7m, b
\'b6o t\'e5n, ph\'b8t tri\'d3n, ph\'e6 bi\'d5n v\'a8n ho\'b8 d\'a9n t\'e9c; tri\'d3n l\'b7m v\'b5 ho\'b9t \'ae\'e9ng th\'d3 d\'f4c th\'d3 thao kh\'abng nh\'bbm m\'f4c \'ae\'ddch kinh doanh, \'ae\'ad\'eec h\'ad\'ebng \'adu \'ae\'b7i v\'d2 thu\'d5 su\'ca
t thu\'d5 thu nh\'cbp doanh nghi\'d6p nh\'ad sau : 
\par }\pard\plain \qj \fi540\li0\ri0\sl281\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs28\cf0\insrsid9532946 \tab 
\par - \'a7\'ad\'eec \'b8p d\'f4ng m\'f8c thu\'d5 su\'cat 15% n\'d5u ho\'b9t \'ae\'e9ng t\'b9i c\'b8c \'ae\'dea b\'b5n c\'e3 \'aei\'d2u ki\'d6n kinh t\'d5 - x\'b7 h\'e9i \'ae\'c6c bi\'d6t kh\'e3 kh\'a8n. 
\par 
\par - \'a7\'ad\'eec \'b8p d\'f4ng m\'f8c thu\'d5 su\'cat 20% n\'d5u ho\'b9t \'ae\'e9ng t\'b9i c\'b8c \'ae\'dea b\'b5n c\'e3 \'aei\'d2u ki\'d6n kinh t\'d5 - x\'b7 h\'e9i kh\'e3 kh\'a8n.
\par 
\par -}{\fs28\expnd-1\expndtw-8\cf0\insrsid9532946  \'a7\'ad\'eec \'b8p d\'f4ng m\'f8c thu\'d5 su\'cat 25% n\'d5u ho\'b9t \'ae\'e9ng ngo\'b5i c\'b8c \'ae\'dea b\'b5n n\'e3i tr\'aan.
\par }{\fs28\cf0\insrsid9532946 
\par }\pard \qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 b) C\'b8c tr\'ad\'eang h\'eep kh\'b8c kh\'abng quy \'ae\'denh t\'b9i \'aei\'d3m a kho\'b6n 1 \'a7i\'d2u n\'b5y, th\'d7 \'b8p d\'f4ng m\'f8
c thu\'d5 su\'cat 32% theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt hi\'d6n h\'b5nh. 
\par 
\par c) C\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp kh\'abng ph\'b6i n\'e9p thu\'d5 thu nh\'cbp doanh nghi\'d6p b\'e6 sung \'ae\'e8i v\'edi thu nh\'cbp t\'f5 c\'b8c ho\'b9t \'ae\'e9ng n\'aau t\'b9i \'aei\'d3m a, kho\'b6n 1, \'a7i\'d2u n\'b5y. 
\par 
\par 
\par }\pard \qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 2. V\'d2 mi\'d4n, gi\'b6m thu\'d5 thu nh\'cbp doanh nghi\'d6p : 
\par }\pard \qj \fi547\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par }\pard \qj \fi547\li0\ri0\sl274\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\expnd0\expndtw-4\cf0\insrsid9532946 a) C\'ac s\'eb ngo\'b5i c\'abng l\'cbp m\'edi th\'b5nh l\'cbp trong c\'b8c l\'dcnh v\'f9c gi\'b8o d\'f4c, y t\'d5, v\'a8n ho
\'b8, th\'d3 thao bao g\'e5m : c\'b8c tr\'ad\'eang h\'e4c \'eb c\'b8c b\'cbc h\'e4c; c\'b8c c\'ac s\'eb  d\'b9y ngh\'d2, n\'a9ng cao tay ngh\'d2 cho c\'abng nh\'a9n, b\'e5i d\'ad\'ecng v\'b5 n\'a9ng cao ki\'d5n th\'f8c qu\'b6n l\'fd kinh doanh; c\'b8c c
\'ac s\'eb y t\'d5 trong c\'b8c l\'dcnh v\'f9c kh\'b8m b\'d6nh, ch\'f7a b\'d6nh; c\'b8c nh\'b5 v\'a8n ho\'b8 d\'a9n t\'e9c; c\'b8c \'aeo\'b5n ca, m\'f3a, nh\'b9c d\'a9n t\'e9c; c\'b8c c\'ac s\'eb s\'adu t\'c7m, b\'b6o t\'e5n, ph\'b8t tri\'d3n, ph\'e6 bi
\'d5n v\'a8n ho\'b8 d\'a9n t\'e9c; c\'b8c trung t\'a9m t\'cbp luy\'d6n v\'b5 thi \'ae\'cau th\'d3 thao; v\'b5 nh\'f7ng tr\'ad\'eang h\'eep kh\'b8c theo quy \'ae\'denh c\'f1a Ch\'ddnh ph\'f1,}{\expnd0\expndtw-4\insrsid9532946  }{
\fs28\expnd0\expndtw-4\cf0\insrsid9532946 \'ae\'ad\'eec h\'ad\'ebng \'adu \'ae\'b7i v\'d2 mi\'d4n, gi\'b6m thu\'d5 thu nh\'cbp doanh nghi\'d6p, k\'d3 t\'f5 khi c\'e3 thu nh\'cbp ch\'deu thu\'d5 nh\'ad sau : 
\par }\pard \qj \fi540\li0\ri0\sl274\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par }\pard \qj \fi547\li0\ri0\sl274\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 - \'a7\'ad\'eec mi\'d4n 4 n\'a8m \'ae\'c7u v\'b5 \'ae\'ad\'eec gi\'b6m 50% s\'e8 thu\'d5 ph\'b6i n\'e9p trong 9 n\'a8m ti\'d5p theo \'ae\'e8
i v\'edi c\'b8c c\'ac s\'eb \'ae\'c7u t\'ad t\'b9i c\'b8c \'ae\'dea b\'b5n c\'e3 \'aei\'d2u ki\'d6n kinh t\'d5 - x\'b7 h\'e9i \'ae\'c6c bi\'d6t kh\'e3 kh\'a8n.
\par 
\par }\pard\plain \s19\qj \fi547\li0\ri0\sl274\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\insrsid9532946 - \'a7\'ad\'eec mi\'d4n 4 n\'a8m \'ae\'c7u v\'b5 \'ae\'ad\'eec gi\'b6m 50% s\'e8
 thu\'d5 ph\'b6i n\'e9p trong 7 n\'a8m ti\'d5p theo \'ae\'e8i v\'edi c\'b8c c\'ac s\'eb \'ae\'c7u t\'ad t\'b9i c\'b8c \'ae\'dea b\'b5n c\'e3 \'aei\'d2u ki\'d6n kinh t\'d5 - x\'b7 h\'e9i kh\'e3 kh\'a8n.
\par }\pard\plain \qj \fi540\li0\ri0\sl274\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs28\cf0\insrsid9532946 
\par }\pard \qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 - \'a7\'ad\'eec mi\'d4n 2 n\'a8m \'ae\'c7u v\'b5 \'ae\'ad\'eec gi\'b6m 50% s\'e8 thu\'d5 ph\'b6i n\'e9p trong 4 n\'a8m ti\'d5p theo \'ae\'e8i v\'edi c\'b8
c c\'ac s\'eb \'ae\'c7u t\'ad ngo\'b5i c\'b8c \'ae\'dea b\'b5n n\'e3i tr\'aan.
\par }\pard\plain \s19\qj \fi540\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\expnd0\expndtw-4\insrsid9532946 
\par b) C\'ac s\'eb ngo\'b5i c\'abng l\'cbp quy \'ae\'denh t\'b9i \'aei\'d3m a, kho\'b6n 1, \'a7i\'d2u n\'b5y c\'e3 \'ae\'c7u t\'ad m\'eb r\'e9ng quy m\'ab, \'ae\'e6i m\'edi c\'abng ngh\'d6, c\'b6i thi\'d6n sinh th\'b8i, m\'abi tr\'ad\'eang \'ae\'ad\'eec h\'ad
\'ebng \'adu \'ae\'b7i v\'d2 mi\'d4n, gi\'b6m thu\'d5 thu nh\'cbp doanh nghi\'d6p cho ph\'c7n thu nh\'cbp t\'a8ng th\'aam do \'ae\'c7u t\'ad m\'edi mang l\'b9i, k\'d3 t\'f5 khi c\'e3 thu nh\'cbp ch\'deu thu\'d5 nh\'ad sau : 
\par }\pard\plain \qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs28\cf0\insrsid9532946 \tab 
\par - \'a7\'ad\'eec mi\'d4n 4 n\'a8m v\'b5 \'ae\'ad\'eec gi\'b6m 50% s\'e8 thu\'d5 ph\'b6i n\'e9p trong 7 n\'a8m ti\'d5p theo n\'d5u ho\'b9t \'ae\'e9ng t\'b9i c\'b8c \'ae\'dea b\'b5n c\'e3 \'aei\'d2u ki\'d6n kinh t\'d5 - x\'b7 h\'e9i \'ae\'c6c bi\'d6t kh\'e3
 kh\'a8n.   
\par }\pard \qj \fi540\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par - \'a7\'ad\'eec mi\'d4n 3 n\'a8m v\'b5 \'ae\'ad\'eec gi\'b6m 50% s\'e8 thu\'d5 ph\'b6i n\'e9p trong 5 n\'a8m ti\'d5p theo n\'d5u ho\'b9t \'ae\'e9ng t\'b9i c\'b8c \'ae\'dea b\'b5n c\'e3 \'aei\'d2u ki\'d6n kinh t\'d5 - x\'b7 h\'e9i kh\'e3 kh\'a8n. 
\par }\pard \qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par - \'a7\'ad\'eec mi\'d4n 1 n\'a8m v\'b5 \'ae\'ad\'eec gi\'b6m 50% s\'e8 thu\'d5 ph\'b6i n\'e9p trong 4 n\'a8m ti\'d5p theo n\'d5u ho\'b9t \'ae\'e9ng ngo\'b5i c\'b8c \'ae\'dea b\'b5n n\'e3i tr\'aan. 
\par 
\par Tr\'d7nh t\'f9, th\'f1 t\'f4c, ph\'ad\'acng ph\'b8p x\'b8c \'ae\'denh s\'e8 thu\'d5 \'ae\'ad\'eec mi\'d4n, gi\'b6m theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt v\'d2 thu\'d5 hi\'d6n h\'b5nh.  
\par }\pard \qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par 
\par }\pard \qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 13. }{\fs28\cf0\insrsid9532946 Trong nh\'f7ng tr\'ad\'eang h\'eep c\'c7n thi\'d5t ph\'b6i \'ae\'c7u t\'ad x\'a9y d\'f9ng c\'ac s
\'eb h\'b9 t\'c7ng, m\'eb r\'e9ng v\'b5 n\'a9ng cao ch\'cat l\'ad\'eeng c\'b8c ho\'b9t \'ae\'e9ng, Nh\'b5 n\'ad\'edc c\'e3 th\'d3 t\'b5i tr\'ee l\'b9i cho c\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp s\'e8 thu\'d5 thu nh\'cbp doanh nghi\'d6p m\'b5 c\'ac s
\'eb ngo\'b5i c\'abng l\'cbp ph\'b6i n\'e9p \'ae\'e8i v\'edi ph\'c7n thu nh\'cbp t\'f5 vi\'d6c th\'f9c hi\'d6n c\'b8c ho\'b9t \'ae\'e9ng d\'b9y h\'e4c; d\'b9y ngh\'d2; kh\'b8m b\'d6nh, ch\'f7a b\'d6nh; bi\'d3u di\'d4n ca, m\'f3a, nh\'b9c d\'a9n t\'e9
c, ngh\'d6 thu\'cbt d\'a9n t\'e9c, chi\'d5u phim; s\'adu t\'c7m, b\'b6o t\'e5n, ph\'b8t tri\'d3n, ph\'e6 bi\'d5n v\'a8n ho\'b8 d\'a9n t\'e9c; tri\'d3n l\'b7m v\'b5 ho\'b9t \'ae\'e9ng th\'d3 d\'f4c th\'d3 thao kh\'abng nh\'bbm m\'f4c \'ae\'ddch kinh doanh.

\par 
\par }\pard\plain \s19\qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\insrsid9532946 S\'e8 ti\'d2n t\'b5i tr\'ee c\'f1a Nh\'b5 n\'ad\'edc t\'e8i \'aea b\'bbng s\'e8
 thu\'d5 thu nh\'cbp doanh nghi\'d6p m\'b5 c\'ac s\'eb ngo\'b5i c\'abng l\'cbp ph\'b6i n\'e9p. C\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp ch\'d8 \'ae\'ad\'eec s\'f6 d\'f4ng kho\'b6n ti\'d2n t\'b5i tr\'ee c\'f1a Nh\'b5 n\'ad\'edc v\'b5o vi\'d6c ph\'b8t tri
\'d3n c\'ac s\'eb v\'cbt ch\'cat, t\'a8ng c\'ad\'eang m\'eb r\'e9ng v\'b5 n\'a9ng cao ch\'cat l\'ad\'eeng ho\'b9t \'ae\'e9ng c\'f1a c\'ac s\'eb. 
\par }\pard\plain \qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs28\cf0\insrsid9532946 
\par }\pard\plain \s19\qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\insrsid9532946 B\'e9 T\'b5i ch\'ddnh h\'ad\'edng d\'c9n c\'f4 th\'d3 tr\'d7nh t\'f9 v\'b5 th\'f1
 t\'f4c t\'b5i tr\'ee; th\'f9c hi\'d6n ki\'d3m tra vi\'d6c s\'f6 d\'f4ng kho\'b6n t\'b5i tr\'ee \'eb c\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp theo quy \'ae\'denh t\'b9i \'a7i\'d2u n\'b5y. 
\par }\pard\plain \qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs28\cf0\insrsid9532946 
\par }\pard \qj \fi540\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 14.}{\fs28\cf0\insrsid9532946  Thu\'d5 thu nh\'cbp \'ae\'e8i v\'edi ng\'ad\'eai c\'e3 thu nh\'cbp cao
\par 
\par }\pard\plain \s19\qj \fi540\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\insrsid9532946 Nh\'f7ng ng\'ad\'eai thu\'e9c c\'ac s\'eb c\'abng l\'cbp n\'d5u l\'b5m th\'aam gi
\'ea \'eb c\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp \'ae\'ad\'eec mi\'d4n thu\'d5 thu nh\'cbp \'ae\'e8i v\'edi ng\'ad\'eai c\'e3 thu nh\'cbp cao t\'f5 ph\'c7n thu nh\'cbp do c\'ac s\'eb ngo\'b5i c\'abng l\'cbp chi tr\'b6. 
\par }\pard\plain \qj \fi540\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs28\cf0\insrsid9532946 
\par C\'b8 nh\'a9n g\'e3p v\'e8n v\'b5o c\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp \'ae\'ad\'eec mi\'d4n thu\'d5 thu nh\'cbp \'ae\'e8i v\'edi ng\'ad\'eai c\'e3 thu nh\'cbp cao t\'f5 ph\'c7n thu nh\'cbp g\'e3p v\'e8n do c\'ac s\'eb ngo\'b5i c\'abng l\'cb
p chi tr\'b6.
\par 
\par }{\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 15.}{\fs28\cf0\insrsid9532946  V\'d2 thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u
\par 
\par }\pard \qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 1. C\'ac s\'eb ngo\'b5i c\'abng l\'cbp th\'f9c hi\'d6n c\'b8c ho\'b9t \'ae\'e9ng thu\'e9c di\'d6n \'adu \'ae\'b7i quy \'ae\'denh t\'b9i \'aei\'d3m a, kho
\'b6n 1, \'a7i\'d2u 12, Ngh\'de \'ae\'denh n\'b5y \'ae\'ad\'eec mi\'d4n thu\'d5 nh\'cbp kh\'c8u \'ae\'e8i v\'edi h\'b5ng ho\'b8 sau \'ae\'a9y m\'b5 trong n\'ad\'edc ch\'ada s\'b6n xu\'cat \'ae\'ad\'eec ho\'c6c s\'b6n xu\'cat \'ae\'ad\'eec nh\'adng ch\'ad
a \'ae\'b8p \'f8ng \'ae\'ad\'eec y\'aau c\'c7u ch\'cat l\'ad\'eeng : 
\par 
\par - Thi\'d5t b\'de, m\'b8y m\'e3c v\'b5 ph\'ad\'acng ti\'d6n v\'cbn t\'b6i chuy\'aan d\'f4ng n\'bbm trong d\'a9y chuy\'d2n c\'abng ngh\'d6 nh\'cbp kh\'c8u \'ae\'d3 t\'b9o t\'b5i s\'b6n c\'e8 \'ae\'denh c\'f1a c\'ac s\'eb ngo\'b5i c\'abng l\'cbp ho\'c6c \'ae
\'d3 m\'eb r\'e9ng quy m\'ab \'ae\'c7u t\'ad, \'ae\'e6i m\'edi c\'abng ngh\'d6.  
\par 
\par }\pard\plain \s20\qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\expnd-1\expndtw-8\insrsid9532946 - Ph\'ad\'acng ti\'d6n v\'cbn chuy\'d3n chuy\'aan d\'efng \'ae\'d3 \'ae\'ada 
\'ae\'e3n c\'b8n b\'e9, gi\'b8o vi\'aan, h\'e4c sinh. 
\par }\pard\plain \qj \fi540\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs28\cf0\insrsid9532946 
\par }\pard\plain \s20\qj \fi540\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\insrsid9532946 2. Thi\'d5t b\'de, m\'b8y m\'e3c v\'b5 ph\'ad\'acng ti\'d6n v\'cbn t\'b6i chuy\'aan d\'f4ng 
\'ae\'ad\'eec mi\'d4n thu\'d5 nh\'cbp kh\'c8u ph\'b6i \'ae\'ad\'eec c\'ac quan c\'e3 th\'c8m quy\'d2n quy\'d5t \'ae\'denh cho h\'ad\'ebng \'adu \'ae\'b7i ch\'cap thu\'cbn v\'b5 ph\'b6i \'ae\'a8ng k\'fd v\'edi h\'b6i quan c\'f6a kh\'c8u \'ae\'d3 th\'f9c hi
\'d6n. 
\par }\pard\plain \qj \fi540\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs28\cf0\insrsid9532946 
\par 3. Danh m\'f4c thi\'d5t b\'de, m\'b8y m\'e3c v\'b5 ph\'ad\'acng ti\'d6n v\'cbn t\'b6i chuy\'aan d\'f4ng \'ae\'ad\'eec mi\'d4n thu\'d5 nh\'cbp kh\'c8u, th\'c8m quy\'d2n quy\'d5t \'ae\'denh mi\'d4n thu\'d5 \'ae\'e8i v\'edi c\'b8c c\'ac s\'eb ngo\'b5i c\'ab
ng l\'cbp quy \'ae\'denh t\'b9i \'a7i\'d2u n\'b5y \'ae\'ad\'eec \'b8p d\'f4ng theo quy \'ae\'denh c\'f1a Lu\'cbt Thu\'d5 xu\'cat kh\'c8u, Thu\'d5 nh\'cbp kh\'c8u; Lu\'cbt Khuy\'d5n kh\'ddch \'ae\'c7u t\'ad trong n\'ad\'edc v\'b5 c\'b8c v\'a8n b\'b6n ph
\'b8p lu\'cbt hi\'d6n h\'b5nh.
\par }\pard \qj \li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par }\pard\plain \s4\qc \li0\ri0\keepn\nowidctlpar\faauto\outlinelevel3\adjustright\rin0\lin0\itap0 \b\f37\fs26\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang2057\langfe1033\langnp2057\insrsid9532946 III. t\'ddn d\'f4ng
\par }\pard\plain \qj \li0\ri0\sl288\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\cf0\insrsid9532946 
\par }\pard \qj \fi540\li0\ri0\sl288\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 16. }{\fs28\cf0\insrsid9532946 C\'ac s\'eb ngo\'b5i c\'abng l\'cbp th\'f9c hi\'d6n c\'b8c ho\'b9t \'ae\'e9ng thu\'e9c di\'d6n 
\'adu \'ae\'b7i quy \'ae\'denh t\'b9i \'aei\'d3m a kho\'b6n 1, \'a7i\'d2u 12, Ngh\'de \'ae\'denh n\'b5y \'ae\'ad\'eec h\'ad\'ebng c\'b8c ch\'d5 \'ae\'e9 \'adu \'ae\'b7i t\'ddn d\'f4ng c\'f1a Nh\'b5 n\'ad\'edc theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt hi
\'d6n h\'b5nh \'ae\'d3 x\'a9y d\'f9ng c\'ac s\'eb v\'cbt ch\'cat, mua s\'bem trang thi\'d5t b\'de ph\'f4c v\'f4 nhi\'d6m v\'f4 chuy\'aan m\'abn c\'f1a c\'b8c \'ae\'acn v\'de theo d\'f9 \'b8n \'ae\'ad\'eec c\'cap c\'e3 th\'c8m quy\'d2n ph\'aa duy\'d6t.

\par }\pard\plain \s4\qc \li0\ri0\keepn\nowidctlpar\faauto\outlinelevel3\adjustright\rin0\lin0\itap0 \b\f37\fs26\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang2057\langfe1033\langnp2057\insrsid9532946 
\par IV. b\'b6o hi\'d3m
\par }\pard\plain \qj \li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\cf0\insrsid9532946 
\par }\pard \qj \fi547\li0\ri0\sl288\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 17. }{\fs28\cf0\insrsid9532946 C\'ac s\'eb ngo\'b5i c\'abng l\'cbp c\'e3 tr\'b8ch nhi\'d6m th\'f9c hi\'d6n v\'b5 h\'ad\'edng d
\'c9n ng\'ad\'eai lao \'ae\'e9ng trong \'ae\'acn v\'de th\'f9c hi\'d6n \'ae\'c7y \'ae\'f1 c\'b8c quy \'ae\'denh hi\'d6n h\'b5nh c\'f1a Nh\'b5 n\'ad\'edc v\'d2 B\'b6o hi\'d3m x\'b7 h\'e9i, B\'b6o hi\'d3m y t\'d5 \'ae\'d3 ng\'ad\'eai lao \'ae\'e9ng trong 
\'ae\'acn v\'de \'ae\'ad\'eec h\'ad\'ebng c\'b8c quy\'d2n l\'eei v\'d2 B\'b6o hi\'d3m x\'b7 h\'e9i, B\'b6o hi\'d3m y t\'d5 nh\'ad ng\'ad\'eai lao \'ae\'e9ng trong \'ae\'acn v\'de c\'abng l\'cbp. 
\par 
\par C\'abng ch\'f8c, ng\'ad\'eai lao \'ae\'e9ng chuy\'d3n c\'abng t\'b8c t\'f5 c\'ac s\'eb c\'abng l\'cbp sang c\'ac s\'eb ngo\'b5i c\'abng l\'cbp \'ae\'ad\'eec b\'b6o l\'adu ph\'c7n b\'b6o hi\'d3m x\'b7 h\'e9i c\'f1a th\'eai gian c\'abng t\'b8c \'eb c\'ac s
\'eb c\'abng l\'cbp; ho\'c6c \'ae\'ad\'eec gi\'b6i quy\'d5t theo ch\'d5 \'ae\'e9 tr\'ee c\'cap 1 l\'c7n theo quy \'ae\'denh c\'f1a Nh\'b5 n\'ad\'edc n\'d5u c\'abng ch\'f8c, ng\'ad\'eai lao \'ae\'e9ng \'ae\'e3 c\'e3 y\'aau c\'c7u. 
\par }\pard \qc \li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f37\fs24\cf0\insrsid9532946 
\par }\pard\plain \s4\qc \li0\ri0\keepn\nowidctlpar\faauto\outlinelevel3\adjustright\rin0\lin0\itap0 \b\f37\fs26\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang2057\langfe1033\langnp2057\insrsid9532946 V. khen th\'ad\'ebng, phong t\'c6ng danh hi\'d6u

\par }\pard\plain \qj \li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\cf0\insrsid9532946 
\par }\pard \qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 18. }{\fs28\cf0\insrsid9532946 Ng\'ad\'eai lao \'ae\'e9ng trong c\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp \'ae\'ad\'eec Nh\'b5 n
\'ad\'edc x\'d0t t\'c6ng gi\'cay khen, b\'bbng khen, hu\'a9n ch\'ad\'acng, huy ch\'ad\'acng, phong t\'c6ng c\'b8c danh hi\'d6u cao qu\'fd nh\'ad \'ae\'e8i v\'edi ng\'ad\'eai lao \'ae\'e9ng trong c\'b8c c\'ac s\'eb c\'abng l\'cbp v\'b5 \'ae\'ad\'eec h\'ad
\'ebng ti\'d2n th\'ad\'ebng theo m\'f8c quy \'ae\'denh c\'f1a Nh\'b5 n\'ad\'edc t\'f5 ngu\'e5n ng\'a9n s\'b8ch nh\'b5 n\'ad\'edc. 
\par }\pard \qc \li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par 
\par }{\b\fs28\cf0\insrsid9532946 Ch\'ad\'acng III
\par }{\b\f37\cf0\insrsid9532946 qu\'b6n l\'fd T\'b5i ch\'ddnh
\par }\pard \qc \li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f37\cf0\insrsid9532946 
\par }\pard \qj \fi540\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 19. }{\fs28\cf0\insrsid9532946 C\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp t\'e6 ch\'f8c thu ph\'dd, thu ti\'d2n d\'dech v\'f4
, thu do b\'b8n s\'b6n ph\'c8m v\'b5 c\'b8c kho\'b6n thu kh\'b8c \'ae\'d3 b\'ef \'ae\'bep chi ph\'dd theo quy \'ae\'denh c\'f1a Ch\'ddnh ph\'f1 v\'b5 c\'b8c c\'ac quan c\'e3 th\'c8m quy\'d2n :
\par  
\par 1. Thu h\'e4c ph\'dd, vi\'d6n ph\'dd, thu c\'b8c c\'b8c kho\'b6n \'ae\'e3ng g\'e3p theo quy \'ae\'denh c\'f1a Ch\'ddnh ph\'f1 v\'b5 c\'f1a c\'ac quan c\'e3 th\'c8m quy\'d2n. 
\par 
\par 2. Thu d\'dech v\'f4, thu do b\'b8n s\'b6n ph\'c8m theo gi\'b8 tho\'b6 thu\'cbn gi\'f7a \'ae\'acn v\'de cung c\'cap d\'dech v\'f4 v\'b5 ng\'ad\'eai th\'f4 h\'ad\'ebng d\'dech v\'f4... (tr\'f5 nh\'f7ng s\'b6n ph\'c8m d\'dech v\'f4 do Nh\'b5 n\'ad\'edc \'ae
\'denh gi\'b8). 
\par 
\par Ngo\'b5i c\'b8c kho\'b6n thu n\'e3i tr\'aan, c\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp \'ae\'ad\'eec nh\'cbn t\'b5i tr\'ee c\'f1a c\'b8c t\'e6 ch\'f8c, c\'b8 nh\'a9n trong n\'ad\'edc v\'b5 n\'ad\'edc ngo\'b5i theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt v
\'d2 qu\'b6n l\'fd, s\'f6 d\'f4ng c\'b8c ngu\'e5n t\'b5i tr\'ee.
\par }\pard \qj \fi540\li0\ri0\sl288\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par }\pard \qj \fi547\li0\ri0\sl288\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 20.}{\fs28\cf0\insrsid9532946  K\'d5t qu\'b6 t\'b5i ch\'ddnh h\'b5ng n\'a8m c\'f1a c\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp 
\'ae\'ad\'eec x\'b8c \'ae\'denh tr\'aan c\'ac s\'eb ch\'aanh l\'d6ch gi\'f7a t\'e6ng s\'e8 thu v\'b5 t\'e6ng s\'e8 chi c\'f1a \'ae\'acn v\'de trong n\'a8m t\'b5i ch\'ddnh sau khi ho\'b5n th\'b5nh ngh\'dca v\'f4 thu n\'e9p cho ng\'a9n s\'b8ch nh\'b5 n\'ad
\'edc theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt. Thu nh\'cbp c\'f1a \'ae\'acn v\'de \'ae\'ad\'eec tr\'ddch l\'b9i m\'e9t ph\'c7n \'ae\'d3 b\'e6 sung ngu\'e5n v\'e8n, chi t\'a8ng c\'ad\'eang c\'ac s\'eb v\'cbt ch\'cat, gi\'b6m m\'f8c thu ph\'dd, tr\'ee c
\'cap m\'e9t ph\'c7n kinh ph\'dd cho c\'b8c \'ae\'e8i t\'ad\'eeng ch\'ddnh s\'b8ch; chi khen th\'ad\'ebng v\'b5 ph\'f3c l\'eei cho nh\'f7ng ng\'ad\'eai lao \'ae\'e9ng trong \'ae\'acn v\'de v\'b5 c\'b8c \'ae\'e8i t\'ad\'eeng tr\'f9c ti\'d5p h\'eep t\'b8c v
\'edi \'ae\'acn v\'de. S\'e8 c\'dfn l\'b9i \'ae\'ad\'eec ph\'a9n ph\'e8i theo t\'fb l\'d6 v\'e8n g\'e3p c\'f1a Nh\'b5 n\'ad\'edc, t\'cbp th\'d3 v\'b5 c\'b8 nh\'a9n tham gia c\'ac s\'eb ngo\'b5i c\'abng l\'cbp. 
\par 
\par Ph\'c7n thu nh\'cbp c\'e3 \'ae\'ad\'eec t\'f5 ngu\'e5n v\'e8n g\'e3p c\'f1a Nh\'b5 n\'ad\'edc \'ae\'ad\'eec \'ae\'d3 l\'b9i cho c\'ac s\'eb \'ae\'d3 ti\'d5p t\'f4c \'ae\'c7u t\'ad.
\par 
\par }\pard \qj \fi540\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 21. }{\fs28\cf0\insrsid9532946 C\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp ph\'b6i \'ae\'a8ng k\'fd v\'edi c\'ac quan t\'b5i ch
\'ddnh; t\'e6 ch\'f8c c\'abng t\'b8c k\'d5 to\'b8n, th\'e8ng k\'aa theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt; \'ae\'denh k\'fa h\'b5ng qu\'fd, n\'a8m l\'cbp b\'b8o c\'b8o quy\'d5t to\'b8n to\'b5n b\'e9 thu, chi, t\'a8ng gi\'b6m v\'e8n v\'b5 t\'b5i s\'b6
n theo c\'b8c ngu\'e5n g\'f6i c\'ac quan t\'b5i ch\'ddnh; th\'f9c hi\'d6n c\'abng khai v\'d2 t\'b5i ch\'ddnh theo quy \'ae\'denh c\'f1a ph\'b8p lu\'cbt. C\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp ph\'b6i ch\'cap h\'b5nh ch\'d5 \'ae\'e9 k\'d5 to\'b8n ph
\'ef h\'eep v\'edi lo\'b9i h\'d7nh ho\'b9t \'ae\'e9ng c\'f1a \'ae\'acn v\'de trong t\'f5ng l\'dcnh v\'f9c theo h\'ad\'edng d\'c9n c\'f1a B\'e9 T\'b5i ch\'ddnh. 
\par }\pard \qc \li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 
\par Ch\'ad\'acng IV
\par }\pard \qc \li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\f37\cf0\insrsid9532946 Qu\'b6n l\'fd Nh\'b5 n\'ad\'edc \'ae\'e8i v\'edi c\'b8c c\'ac s\'eb 
\par ngo\'b5i c\'abng l\'cbp ho\'b9t \'ae\'e9ng trong l\'dcnh v\'f9c 
\par gi\'b8o d\'f4c, y t\'d5, v\'a8n ho\'b8, th\'d3 thao
\par }\pard \qj \li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\cf0\insrsid9532946 
\par }\pard \qj \fi547\li0\ri0\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\b\fs28\cf0\insrsid9532946 \'a7i\'d2u 22. }{\fs28\cf0\insrsid9532946 N\'e9i dung qu\'b6n l\'fd Nh\'b5 n\'ad\'edc \'ae\'e8i v\'edi c\'b8c c\'ac s\'eb ngo\'b5i c\'abng l\'cbp ho\'b9t 
\'ae\'e9ng trong l\'dcnh v\'f9c gi\'b8o d\'f4c, y t\'d5, v\'a8n ho\'b8, th\'d3 thao, bao g\'e5m : 
\par }\pard \qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 {\fs28\cf0\insrsid9532946 
\par 1. Tr\'aan c\'ac s\'eb chi\'d5n l\'ad\'eec, quy ho\'b9ch v\'b5 k\'d5 ho\'b9ch th\'f9c hi\'d6n trong t\'f5ng th\'eai k\'fa v\'b5 h\'b5ng n\'a8m \'ae\'e8i v\'edi gi\'b8o d\'f4c, y t\'d5, v\'a8n ho\'b8, th\'d3 thao, x\'a9y d\'f9ng \'ae\'denh h\'ad\'edng x
\'b7 h\'e9i ho\'b8 trong t\'f5ng l\'dcnh v\'f9c l\'b5m c\'a8n c\'f8 cho c\'b8c c\'cap, c\'b8c ng\'b5nh v\'b5 nh\'a9n d\'a9n t\'e6 ch\'f8c th\'f9c hi\'d6n. 
\par }{\fs10\cf0\insrsid9532946 
\par }{\fs28\cf0\insrsid9532946 
\par }\pard\plain \s19\qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs28\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\insrsid9532946 2. Ban h\'b5nh c\'b8c ch\'ddnh s\'b8ch, ch\'d5 \'ae\'e9 khuy\'d5n kh\'ddch x\'b7
 h\'e9i ho\'b8 ph\'ef h\'eep v\'edi c\'b8c h\'d7nh th\'f8c ho\'b9t \'ae\'e9ng trong gi\'b8o d\'f4c, y t\'d5, v\'a8n ho\'b8, th\'d3 thao, ph\'ef h\'eep v\'edi y\'aau c\'c7u ph\'b8t tri\'d3n c\'f1a t\'f5ng l\'dcnh v\'f9c trong t\'f5ng th\'eai k\'fa v\'b5 t
\'f5ng khu v\'f9c. 
\par }\pard\plain \qj \fi547\li0\ri0\sl276\slmult1\nowidctlpar\faauto\adjustright\rin0\lin0\itap0 \f38\fs26\cf9\lang2057\langfe1033\cgrid\langnp2057\langfenp1033 {\fs10\cf0\insrsid9532946 
\par }{\fs28\cf0\insrsid9532946 
